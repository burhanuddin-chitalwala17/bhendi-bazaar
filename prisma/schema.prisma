generator client {
  provider        = "prisma-client-js"
  // Join strategy for relation reads: one LATERAL JOIN instead of one query per
  // relation table. On per-operation billing that difference is the bill (CHANGELOG
  // PR-70/71). Applied per-query via relationLoadStrategy, not globally.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// One row per worker environment, upserted by the worker on a fixed cadence so admin can
/// say when it was last seen rather than guess (worker-foundation R5). Counts are copied from
/// the queue at the same moment; they are a snapshot, not a source of truth.
model WorkerHeartbeat {
  environment  String   @id
  version      String
  lastSeenAt   DateTime
  waiting      Int
  active       Int
  failed       Int
  /// Jobs finished in the 24 hours before the beat — the figure that says the worker is doing work, not just alive.
  completedDay Int      @default(0)
}

/// Every image the platform stores, as a record (media-library R1): what it is, how big, who
/// owns it, where it came from, and what it was made from. `ref` follows `ProductMedia.ref` —
/// a public URL for an image, a bare video id for an embed — so the two agree by construction.
/// A derived image records its source and its transform and never alters the source (R3).
/// Retired, never deleted, while anything references it (R7): every reference is `Restrict`.
model MediaAsset {
  id        String         @id @default(cuid())
  kind      MediaAssetKind
  ref       String
  /// Our object's pathname when the image lives in our store; null for an external URL or an embed.
  objectKey String?        @unique

  width       Int?
  height      Int?
  bytes       Int?
  mimeType    String?
  /// Playing time of a hosted video; null for anything else (video-hosting D1).
  durationMs  Int?
  /// SHA-256 of the stored bytes, hex. Within an org the same bytes are one asset, so a repeat
  /// upload is answered with the existing record rather than a second copy (media-library D11).
  contentHash String?

  /// Null means platform-owned: category heroes, home banners.
  orgId      String?
  org        Org?    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  source        MediaAssetSource
  derivedFromId String?
  derivedFrom   MediaAsset?      @relation("Derivation", fields: [derivedFromId], references: [id], onDelete: Restrict)
  derivatives   MediaAsset[]     @relation("Derivation")
  /// How a derived asset was made from its source — a crop rectangle, a surface key, an operation.
  transform     Json?
  /// The photograph an org member chose to stand in for this video instead of the derived frame (video-hosting spec R8).
  posterAssetId String?
  posterAsset   MediaAsset?      @relation("VideoPoster", fields: [posterAssetId], references: [id], onDelete: SetNull)
  postersFor    MediaAsset[]     @relation("VideoPoster")

  /// PENDING between the presign and the confirm; READY once the store has the bytes and the
  /// record has the dimensions; RETIRED when nothing should use it any more (trd D2, D8).
  state         MediaAssetState @default(PENDING)
  retiredAt     DateTime?
  /// Who took it out of the library, and why when the platform did (spec R12, trd D10). An
  /// organisation retiring its own picture owes nobody a reason; the platform taking one down
  /// over a breach does, and the organisation is shown both.
  retiredBy     MediaRetiredBy?
  retiredReason String?
  /// Why a video could not be made playable, shown to the org member (video-hosting spec R7).
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productMedia     ProductMedia[]
  categoryHeroes   Category[]          @relation("CategoryHero")
  profileLogos     OrgProfile[]        @relation("ProfileLogo")
  profileHeroes    OrgProfile[]        @relation("ProfileHero")
  profileOwners    OrgProfile[]        @relation("ProfileOwnerPhoto")
  orgBanners       OrgBanner[]         @relation("OrgBannerImage")
  storefrontSlots  OrgStorefrontSlot[] @relation("StorefrontSlotImage")
  banners          Banner[]            @relation("BannerImage")
  /// The phone versions of the same three (image-slots trd D2): a use like the desktop picture.
  orgBannerPhones      OrgBanner[]         @relation("OrgBannerPhoneImage")
  storefrontSlotPhones OrgStorefrontSlot[] @relation("StorefrontSlotPhoneImage")
  bannerPhones         Banner[]            @relation("BannerPhoneImage")
  /// The enhancements asked of this photograph, and the one this photograph was accepted from (image-enhancement trd D1).
  enhancementsFrom Enhancement[]       @relation("EnhancementSource")
  enhancementOf    Enhancement[]       @relation("EnhancementResult")

  @@index([orgId, state])
  @@index([orgId, contentHash])
  @@index([ref])
  @@index([derivedFromId])
  /// What the shop says this image is for (ai-images/media-tags D1); several at once. Product is added
  /// where a gallery links the image, Reference where it is chosen as one; "in use" stays derived.
  tags          MediaTag[]      @default([])

  @@index([posterAssetId])
  @@index([tags], type: Gin)
}

enum MediaAssetKind {
  IMAGE
  VIDEO_EMBED
  /// A video file we host: the upload is the source, its renditions and poster are DERIVED from it (video-hosting D1).
  VIDEO
}

/// The closed set of library tags (ai-images Q21); mirrored as MEDIA_TAG in media-library.types.ts.
enum MediaTag {
  PRODUCT
  REFERENCE
}

enum MediaAssetSource {
  UPLOAD
  DERIVED
  EMBED
}

/// Who retired an image. A closed set rather than a flag, because "the platform did it" is a
/// different fact from "an admin's id", and the organisation is told the first, never the second.
enum MediaRetiredBy {
  ORG
  PLATFORM
}

enum MediaAssetState {
  PENDING
  /// A confirmed video the worker is still making playable (video-hosting D1).
  PROCESSING
  READY
  /// A video no decoder read or that broke a limit; `failureReason` says which (spec R7).
  FAILED
  RETIRED
}

/// One requested improvement of one photograph (image-enhancement trd D1): the ledger row the
/// worker acts on and the quota counts. The proposal is an object under `proposals/`, never an
/// asset, until it is accepted — then `resultAssetId` names the DERIVED image made from it. Cost is
/// integer paise (Invariant 3), recorded per run (spec R9). Money-bearing, so nothing cascades.
model Enhancement {
  id            String           @id @default(cuid())
  orgId         String
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  requesterId   String?
  requester     User?            @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  sourceAssetId String
  sourceAsset   MediaAsset       @relation("EnhancementSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  tool          EnhancementTool
  /// A scene's setting, or any tool's named variant; null for a tool with none.
  preset        String?
  /// Which service performed the run — the platform's choice, recorded so a bake-off can be read back (spec R8).
  provider      String
  state         EnhancementState @default(REQUESTED)
  /// The gallery slot the request came from, for the record; the label slot is refused before a row exists (spec R5).
  slot          String?
  /// Where the proposal sits in the store while nobody has decided on it (trd D1).
  proposalKey   String?
  resultAssetId String?
  resultAsset   MediaAsset?      @relation("EnhancementResult", fields: [resultAssetId], references: [id], onDelete: SetNull)
  costPaise     Int              @default(0)
  /// Why a run failed, in the org member's words (spec R10).
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  proposedAt    DateTime?
  decidedAt     DateTime?

  /// The model calls this run made (ai-images/generation-foundation trd D6).
  generations   Generation[]
  /// A styled run's description in the shop's own words, and its reference pictures (improve-with-ai D1).
  brief         String?
  referenceRefs String[]         @default([])
  /// The shape a styled run was asked in (`1:1`, `4:5`, `9:16`, `4:3`); null is square (improve-with-ai Q42).
  aspect        String?
  /// The run a Regenerate came from (R9).
  previousId    String?
  previous      Enhancement?     @relation("EnhancementRegenerate", fields: [previousId], references: [id], onDelete: Restrict)
  regenerations Enhancement[]    @relation("EnhancementRegenerate")

  @@index([orgId, createdAt])
  @@index([orgId, state])
  @@index([sourceAssetId])
}

/// How one org differs from the platform's numbers, and whether it may enhance at all
/// (image-enhancement trd D5). A row exists only where there is a deviation to record; an org
/// that is exactly the platform default carries none, and use itself is a count of rows, never stored.
model OrgEnhancementPolicy {
  orgId            String    @id
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// An allowance of this org's own. Null is "whatever the platform's default is" — a row records
  /// a deviation, never a copy of the platform's number, which would go stale the day it changes.
  monthlyAllowance Int?
  pausedAt         DateTime?
  pauseReason      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// The platform owner's two numbers, in one row the code addresses by a constant id
/// (image-enhancement trd D5): how many enhancements an org may do in a month unless its own row
/// says otherwise, and what every org together may spend in a day, in paise (Invariant 3). A
/// settings row rather than a constant so the owner changes them without a deploy; no relation to
/// anything, because they belong to the platform rather than to any row in the tree. Absent means
/// the fallbacks declared in `server/content/enhancement.types.ts`.
model EnhancementSettings {
  id                      String   @id @default("platform")
  defaultMonthlyAllowance Int
  dailyCapPaise           Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// One call to an image model (ai-images/generation-foundation trd D6), written before the call so a
/// retried job replays the stored result instead of paying again. Cost is what the platform spent:
/// micro-dollars from the model's price rule and paise at the recorded day's rate (Invariant 3).
model Generation {
  id                  String          @id @default(cuid())
  /// Ours, unique: a retry with the same key never makes a second call that succeeded.
  idempotencyKey      String          @unique
  purpose             String
  /// The registry id (`cf/flux-2-klein-4b`), never the provider's own spelling.
  modelId             String?
  state               GenerationState @default(SUBMITTED)
  promptVersion       String
  platformPrompt      String
  /// The seller's own words, kept apart from the platform's; null where there were none.
  brief               String?
  referenceAssetIds   String[]
  aspect              String
  size                String
  costMicroUsd        Int             @default(0)
  costPaise           Int             @default(0)
  /// The day whose rate priced this call; null for a free model.
  rateDay             DateTime?       @db.Date
  outputKeys          String[]
  synthetic           Boolean         @default(true)
  containsPerson      Boolean         @default(false)
  /// A worker died mid-call and the call was made again: the provider may have billed twice (trd D6).
  retriedAfterUnknown Boolean         @default(false)
  error               String?
  /// The enhancement run this served, if any. Restrict: a record of money spent never cascades (ADR-0020).
  enhancementId       String?
  enhancement         Enhancement?    @relation(fields: [enhancementId], references: [id], onDelete: Restrict)
  createdAt           DateTime        @default(now())
  finishedAt          DateTime?

  @@index([enhancementId])
  @@index([createdAt])
}

enum GenerationState {
  SUBMITTED
  SUCCEEDED
  FAILED
  REFUSED
}

/// What one US dollar cost in paise on a day (generation-foundation trd D7): fetched by the worker,
/// one row a day, never typed into code. An integer, because money is integer paise (Invariant 3).
model ExchangeRate {
  day         DateTime @id @db.Date
  paisePerUsd Int
  source      String
  fetchedAt   DateTime @default(now())
}

enum EnhancementTool {
  CUTOUT
  WHITE
  STUDIO
  SCENE
  LIGHT
  ENLARGE
  /// An AI picture styled from a shop's description and references (ai-images/improve-with-ai D1).
  STYLED
}

enum EnhancementState {
  REQUESTED
  RUNNING
  PROPOSED
  ACCEPTED
  DISCARDED
  FAILED
}

/// Carries an attributes trigger (attributes Q14): a type or parent change re-types the products beneath it
/// and the families whose members now share one type.
model Category {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  /// Self-referencing tree (category-tree D1/D2): null = root. Restrict, so a parent
  /// with children cannot be deleted; cycles are refused on the write path.
  parentId       String?
  parent         Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]     @relation("CategoryTree")
  description    String         @db.Text
  heroImage      String // URL to hero image
  heroAssetId    String?
  heroAsset      MediaAsset?    @relation("CategoryHero", fields: [heroAssetId], references: [id], onDelete: Restrict)
  accent         CategoryAccent @default(EMERALD)
  /// The named photo slots products in this category fill, inherited down the tree from the
  /// nearest ancestor that sets one; null means the platform's generic list (media-library D4).
  shotList       Json?
  /// Which listing questions this category's products are asked, inherited down the tree from the
  /// nearest ancestor that sets one, exactly as `shotList` is (listing-vocabulary/categories D1a).
  /// Null everywhere means a product is asked the spine only — it still saves and still sells.
  /// A browsing category is reorganised for merchandising reasons; the resolved value is copied
  /// onto the product on save (D1b) so moving a category never moves a product's stored answers.
  productType    String?
  productTypeRef ProductType?   @relation(fields: [productType], references: [key], onDelete: Restrict)
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       Product[]

  promotionTargets PromotionTarget[]
  commissionRules  OrgCommissionRule[]
  storefrontSlots  OrgStorefrontSlot[]

  @@index([slug])
  @@index([order])
  @@index([parentId])
}

/// Every list price a product has had and when it took effect (offers-hardening D7, own-store Q21).
/// Written only by the `Product_price_history` trigger, so no writer can skip it; read through
/// catalog (`lowestListPricesSince`). Cascade: it carries no money, and a product anything
/// money-bearing references cannot be deleted anyway (OrderItem is Restrict).
model ProductPriceHistory {
  id         Int      @id @default(autoincrement())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricePaise Int
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, recordedAt])
}

/// A BEFORE trigger sets `productType` from its category on every save, clearing a kind the type lacks
/// (attributes Q14). Its answers live in ProductValue (dynamic-form Q16).
model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @db.Text
  price       Int // paise (Invariant 3). A reduction is an offer, never a column
  /// The printed maximum retail price, in paise (Invariant 3; parent Q27). Filled from a marketplace when empty.
  mrpPaise    Int?
  // on the product — see Promotion (ADR-0018 decision 4, promotions D9).
  currency    String @default("INR")

  categoryId String
  // Restrict, not Cascade: deleting a category must never delete its products
  // (category-tree D3 — the cascade only ever had an application-level count in its way).
  // Now the general rule rather than a local judgement (ADR-0020).
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags  String[] // Array of tags
  flags String[] @default([])
  // `images String[]` was here until product-video; a gallery is `media` now.

  /// Cache of the cover row's `ref` (product-video D4a/D4b), so every listing, search
  /// result, cart line and order line reads one table. Written only by the resolver,
  /// never from input; NOT NULL is the one database-level guarantee that a product has
  /// a picture at all.
  thumbnail String

  sku               String? // Stock Keeping Unit — unique within the org, not the platform
  lowStockThreshold Int     @default(10) // Alert when stock falls below this

  /// The product type resolved from the category tree and kept here (listing-vocabulary/categories D1b),
  /// always its category's: set by a trigger on every save and moved when a category's type or place
  /// changes (listing-model Q9, attributes Q14). A column because it says how to read the answers.
  productType    String?
  /// Which kind within that type — abaya, burqa, attar, bakhoor (categories D1). A column
  /// because the channel mapping resolves a platform node from the type and the kind together,
  /// and because the platforms disagree about which of the two it is.
  kind           String?
  /// Restrict: a type in use is retired, never deleted (product-types D8).
  productTypeRef ProductType? @relation(fields: [productType], references: [key], onDelete: Restrict)

  /// The family this product is a member of, when it has siblings that sell separately
  /// (listing-vocabulary/variants D2). Nullable because one abaya in one colour is one product
  /// and nothing asks a shop to declare a family of one — and because requiring it would refuse
  /// every row that exists. Restrict, not Cascade: a family carries no money, but its members do
  /// ([ADR-0020](../docs/adr/0020-money-bearing-records-never-cascade.md)).
  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id], onDelete: Restrict)

  /// Which of the org's brands this product carries
  /// ([inherited-facts](../docs/specs/listing-vocabulary/inherited-facts/) R1).
  ///
  /// Stored rather than only used: the brand answers what the shop left blank at save time, and
  /// correcting a fact on the brand later has to find the products that took their answer from
  /// it (R5). Without this column that question is unanswerable — the fill would work and the
  /// correction would silently match nothing.
  ///
  /// Restrict: a brand is retired, never deleted, and a retired brand still answers for the
  /// products that named it ([ADR-0032](../docs/adr/0032-records-people-authored-are-retired-not-deleted.md)).
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  stockLocations   ProductStock[]
  media            ProductMedia[]
  promotionTargets PromotionTarget[]
  biddingEvents    BiddingEvent[]
  priceHistory     ProductPriceHistory[]

  // ⭐ Org Association (REQUIRED)
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  weight Float? @default(0.5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  /// When the org took this product off sale ([ADR-0029](../docs/adr/0029-a-product-leaves-sale-by-archiving-not-deletion.md)).
  /// Null means on sale. Nothing else changes: the row, its media, its reviews and
  /// every order it appears on are untouched, and a restore clears this column.
  ///
  /// A timestamp rather than a status enum because there is no third lifecycle state
  /// to model, and "since when" is worth having for free. It is server-owned and
  /// never accepted from a request body (Invariant 4).
  archivedAt      DateTime?
  channelListings ChannelListing[]
  /// Each connected marketplace's listing as the shop means it (channel-listings D1).
  platformListings PlatformListing[]

  /// Up to five short points a marketplace shows first, and the product's barcode (EAN, UPC or
  /// ISBN), a strict field every marketplace shares (channel-listings Q6, parent Q28).
  keyFeatures String[] @default([])
  barcode     String?

  /// Bumped by every person's save and compared on the next one, so a save from a stale form is
  /// refused rather than undoing someone else's (product-form D6, Q35). Not `updatedAt`: that moves
  /// on marketplace fills and archive, which nobody typed.
  version        Int       @default(0)
  /// Who saved last and when, to word that refusal (D7). Restrict: a user is deactivated, never deleted.
  lastEditedById String?
  lastEditedBy   User?     @relation("ProductLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  lastEditedAt   DateTime?
  /// Set by a Bhendi Bazaar team save, cleared by the shop's next save (D7, Q14).
  teamEditedAt   DateTime?

  // A SKU is the org's own identifier; two orgs may legitimately use the same one.
  // It stays taken while the product is archived — a restore must find its own code
  // still free, so uniqueness cannot be conditional on `archivedAt`.
  @@unique([orgId, sku])
  @@index([slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([orgId])
  // The org portal's default list is "this org, on sale", and it is the one query
  // this column adds to a hot path.
  @@index([orgId, archivedAt])
  // A readiness sweep and the channel mapping both work type by type.
  @@index([productType])
  @@index([familyId])
  // The brand-level correction asks for one org's products of one brand.
  @@index([brandId])
  productValues   ProductValue[]
  productValueSet ProductValueSet?
  channelStates   ProductChannelState[]
}

/// One item in a product's gallery — a photograph or an embedded video, in an order
/// the seller composes ([ADR-0017](../docs/adr/0017-video-is-embedded-not-hosted.md),
/// docs/specs/product-video/).
///
/// `position` orders the gallery and means nothing outside it (R16). The cover is the
/// row flagged `isThumbnail`, never the row at position 0, which is what lets a video
/// lead the gallery. Two constraints the schema language cannot express are added as
/// raw SQL in the migration: a partial unique index making at most one cover per
/// product a database fact, and a check that a cover is always an IMAGE.
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind MediaKind
  /// A stored URL for IMAGE and VIDEO, a bare video id for YOUTUBE — never a provider URL, so
  /// the host stays swappable by backfill rather than by migration (ADR-0017 decision 2).
  ref  String

  /// The library record behind an IMAGE row, linked by `ref` on write and by the backfill.
  /// Nullable through the transition; a video reference has none (media-library trd D1).
  assetId String?
  asset   MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)

  position    Int
  /// Which of the category's named slots this item fills; null for an extra beyond the slots or
  /// a video (media-library R4, D4). `position` still orders the gallery.
  slot        String?
  /// Per-item alt text. Nullable because the backfill has none to give: pre-existing
  /// galleries only ever had positional alt text generated at render.
  description String?

  isThumbnail Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId])
}

enum MediaKind {
  IMAGE
  YOUTUBE
  /// A video we host (video-hosting D1); `ref` is the source asset's URL.
  VIDEO
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Required, and Restrict: a review is attribution, so it never loses its author
  /// and its author can never be deleted out from under it (ADR-0032, ADR-0020).
  /// Was nullable with SetNull until PR-125, which cost three branches of defensive
  /// code for a state the platform does not allow.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  rating  Int // 1-5
  title   String?
  comment String? @db.Text

  /// Frozen at write time, never joined from `user` (product-reviews R11): a review is
  /// what someone said at a moment, so renaming an account must not rewrite it.
  userName   String
  isVerified Boolean @default(false) // Verified purchase, awarded from order history (R4)

  /// The platform took it down (R15). Null is published; restoring sets it back to null,
  /// the same shape `Product.archivedAt` uses. Replaced `isApproved`, which said
  /// "approved" about a review nothing ever approves.
  withdrawnAt DateTime?

  /// The author retracted it (R9). A separate act from withdrawal, by a different
  /// person, with a different remedy — one boolean could not tell them apart (ADR-0032).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media ReviewMedia[]

  /// Serves both the product page's newest-first list and the rating projection
  /// (product-reviews trd.md D4): one product, visible only, newest first. Both
  /// state columns are in it because `VISIBLE_REVIEW_WHERE` tests both together.
  @@index([productId, withdrawnAt, deletedAt, createdAt])
  @@index([userId])
  @@index([createdAt])
}

/// A photograph the buyer took, or a video they had already published elsewhere
/// (review-media R1, R5).
///
/// Its own table rather than a `reviewId` on `ProductMedia`: every gallery, cover and
/// thumbnail query reads that one, so a review's picture living there would be one
/// forgotten `where` away from becoming the product's own (review-media trd.md D1).
///
/// Cascade is correct here — a review's media carries no money and no attribution, which
/// is the case ADR-0020 leaves cascading, and R12 wants the rows gone with the review.
/// The objects in R2 are deleted by the service, since a cascade cannot reach them.
model ReviewMedia {
  id       String    @id @default(cuid())
  reviewId String
  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kind     MediaKind
  /// An object URL in our own bucket for IMAGE, a bare video id for YOUTUBE — never a
  /// provider URL (ADR-0017 decision 2).
  ref      String
  /// Array index. A list has an order; nothing outside the review reads it.
  position Int       @default(0)

  @@index([reviewId])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The pre-PR-44 blob, kept one release as the audit copy of the lift. Read by
  // nothing; lines live in CartItem rows (order-and-cart-lines trd.md).
  legacyItems Json?      @map("items")
  items       CartItem[]
  version     Int        @default(1) // For optimistic locking
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Cascade, unlike OrderItem: a cart line is a wish, not history — deleting the
  // product just removes it from carts.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int
  size     String?
  color    String?

  @@index([cartId])
  @@index([productId])
}

/// A user's saved products. One per user, created on the first heart rather than at
/// signup — a wishlist nobody has opened should not exist. No `wlId` on `User`: the
/// unique `userId` here is the whole relationship, and a second copy on the other side
/// is a column that can disagree with this one.
model Wishlist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One saved product. Rows rather than a `productIds String[]` on the parent, for the
/// reason PR-41/43/44 lifted their blobs: an array cannot carry a foreign key, so a
/// deleted product leaves an id nothing resolves, and every add is a read-modify-write
/// of the whole array that a second device silently overwrites.
model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  // Cascade, like CartItem and unlike OrderItem: a saved product is a wish, not
  // history, so deleting the product just removes it from wishlists. ADR-0020 governs
  // rows carrying money or attribution; this one carries neither.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Hearting twice is the same wish: the second click is a no-op, not a duplicate row.
  // Also the index for "is this product saved", so no separate wishlistId index.
  @@unique([wishlistId, productId])
  @@index([productId])
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  emailVerified   DateTime? // Keep this for NextAuth compatibility
  isEmailVerified Boolean      @default(false) // Our custom field
  /// Contact data, not an identity key: one number may back any number of accounts (ADR-0024).
  mobile          String?
  passwordHash    String?
  platformRole    PlatformRole @default(USER)
  /// The platform shut them out. Punitive, admin-reversible, and not the same thing as
  /// `deactivatedAt` below — a banned account and a closed one need different answers.
  isBlocked       Boolean      @default(false)
  /// The account is retired. A user is never deleted (ADR-0032), so this is what
  /// "delete my account" does; rows that attribute to them keep pointing at them.
  deactivatedAt   DateTime?
  lastActiveAt    DateTime     @default(now())
  profile         Profile?
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  reviews         Review[]
  adminLogs       AdminLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accounts              Account[]
  sessions              Session[]
  orgMemberships        OrgMember[]
  mediaAssets           MediaAsset[]
  addresses             UserAddress[]
  enhancementsRequested Enhancement[]

  settlementsCreated       Settlement[] @relation("SettlementCreatedBy")
  promotionLossesConfirmed Promotion[]  @relation("PromotionLossConfirmedBy")
  orgLooksPublished        OrgProfile[] @relation("OrgLookPublishedBy")
  orgContentEdited         OrgProfile[] @relation("OrgStorefrontContentEditedBy")
  settlementsUpdated       Settlement[] @relation("SettlementUpdatedBy")

  bids                 Bid[]               @relation("UserBids")
  biddingEventsCreated BiddingEvent[]      @relation("BiddingCreatedBy")
  biddingEventsSettled BiddingEvent[]      @relation("BiddingSettledBy")
  channelsConnected    ChannelConnection[] @relation("ChannelConnectedBy")
  channelsDisconnected ChannelConnection[] @relation("ChannelDisconnectedBy")
  featuresChanged      OrgFeature[]
  productsLastEdited   Product[]           @relation("ProductLastEditedBy")

  @@index([platformRole])
  @@index([isBlocked])
  @@index([lastActiveAt])
  @@index([isEmailVerified])
}

model Profile {
  id              String  @id @default(cuid())
  user            User    @relation(fields: [userId], references: [id])
  userId          String  @unique
  legacyAddresses Json?   @map("addresses") // pre-PR-41 blob, kept one release as backup; read by nothing
  profilePic      String? // URL to avatar image
}

model Org {
  id   String @id @default(cuid())
  code String @unique // "SEL-001", "SEL-002"

  /// The shop's public address: `/store/<handle>`. Generated from the name at creation
  /// and changeable by its owner thereafter; a retired one is held, then released
  /// (ADR-0030 decision 4). Never accepted on a general org update — only through the
  /// handle-change operation, which is why it is absent from CreateOrgInput.
  handle String @unique
  name   String // "ABC Traders", "XYZ Wholesale"

  // Contact Information
  email         String
  phone         String?
  contactPerson String? // "John Doe"

  // Business Details
  orgAddresses OrgAddress[]

  businessName String?
  gstNumber    String?
  panNumber    String?

  // Status
  isActive   Boolean @default(true)
  isBlocked  Boolean @default(false)
  isVerified Boolean @default(false)

  // Everything a buyer may see lives on the profile; everything else stays here
  // (org-profile spec R1/R2, trd D1). A leak now needs a join nobody wrote.
  profile           OrgProfile?
  storefrontSlots   OrgStorefrontSlot[]
  listingDefaults   OrgListingDefaults?
  brands            Brand[]
  mediaAssets       MediaAsset[]
  enhancements      Enhancement[]
  enhancementPolicy OrgEnhancementPolicy?

  /// The platform's cut, in basis points — 1500 = 15%. Set per org by design; rates
  /// differ between orgs (org-payouts spec R12). Category overrides live in
  /// `OrgCommissionRule`, and the resolved rate is snapshotted onto every ledger
  /// line so a later change cannot rewrite a past settlement (payouts D4).
  commissionBps  Int @default(1500)
  /// How deep this org may discount its **own** goods. A guard against mis-keying a
  /// margin away with self-serve signup — not a platform protection, since an org's
  /// discount shrinks the platform's commission proportionally and can never drive it
  /// negative (promotions D13a).
  maxDiscountBps Int @default(5000)

  /// Home's setup list (own-store onboarding D6, Q23): when the shop hid it, and when it first
  /// tapped Share or Copy link. Written once each, outside `updatedAt` (the contact version).
  setupHiddenAt DateTime?
  firstSharedAt DateTime?

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products  Product[]
  shipments Shipment[]
  members   OrgMember[]

  storefrontBanners OrgBanner[]
  handleHistory     OrgHandleHistory[]

  promotions         Promotion[]
  orderDiscounts     OrderDiscount[]
  commissionRules    OrgCommissionRule[]
  ledgerEntries      OrgLedgerEntry[]
  settlements        Settlement[]
  creditLines        CreditLine[]
  creditPolicy       OrgCreditPolicy?
  biddingEvents      BiddingEvent[]
  listingValues      ListingValue[]
  productFamilies    ProductFamily[]
  channels           OrgChannel[]
  features           OrgFeature[]
  channelConnections ChannelConnection[]
  ticketNeeds        TicketNeed[]

  @@index([email])
  @@index([isActive])
  @@index([isBlocked])
  @@index([code])
  @@index([handle])
}

/// The public face of an organisation: what a storefront or an advertisement may show, and
/// nothing else (org-profile spec R1, trd D1). One row per org, created with it. The storefront
/// reads this table only, so a private column on `Org` cannot reach a buyer by accident.
model OrgProfile {
  orgId String @id
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// One line under the name. Not the introduction; a shelf label, not a paragraph.
  tagline        String?
  /// The storefront's introduction — the long-form "who we are". Plain text, rendered as
  /// text (ADR-0030 D9).
  description    String?     @db.Text
  logoUrl        String?
  /// The shop's cover image, shown at the top of its about page — not on the storefront
  /// itself, where the promotions hold that slot (decided 2026-09-19). Distinct from
  /// `OrgBanner`, a rotating promotion. Through the same object store and optimizer as every
  /// other image (ADR-0026, ADR-0028).
  heroUrl        String?
  logoAssetId    String?
  logoAsset      MediaAsset? @relation("ProfileLogo", fields: [logoAssetId], references: [id], onDelete: Restrict)
  heroAssetId    String?
  heroAsset      MediaAsset? @relation("ProfileHero", fields: [heroAssetId], references: [id], onDelete: Restrict)
  /// A token name from the palette in globals.css — never a colour literal (ADR-0022).
  accent         String?
  /// What this shop promises about delivery and returns. The platform's own terms stand in
  /// where these are null; payment and fraud are never the shop's to disclaim.
  deliveryPolicy String?     @db.Text
  returnsPolicy  String?     @db.Text

  /// The longer story, the location as the shop chooses to state it, and handles on known
  /// networks. All optional; nothing here is required to open a shop (org-profile spec R5).
  story    String? @db.Text
  location String?
  social   Json?

  /// A real person behind the shop, invited and never required (brand-page R5, D6). All four
  /// are independent: a name with no photograph is a story, a photograph with no name is not.
  ownerName         String?
  ownerRole         String?
  ownerQuote        String?     @db.Text
  ownerPhotoUrl     String?
  ownerPhotoAssetId String?
  ownerPhoto        MediaAsset? @relation("ProfileOwnerPhoto", fields: [ownerPhotoAssetId], references: [id], onDelete: Restrict)

  /// At most three `{title, text}` blocks on how or why the shop works as it does, and the
  /// keys of the optional sections the shop has chosen to hide (brand-page R7, D6). Both are
  /// shapes the platform defines and validates on the way in, never free-form documents.
  pillars        Json?
  hiddenSections Json?

  /// When the shop saved "About your shop" (org-profile D4). Until then buyers read the
  /// introduction and `story` joined; after it, `description` alone. `story` is kept, never dropped.
  storyMergedAt DateTime?
  /// The shop's returns promise, one of three the platform can honour (org-profile Q7, D6).
  /// `deliveryPolicy` and `returnsPolicy` above are kept but no longer shown to buyers.
  returnsPreset ReturnsPreset @default(STANDARD)
  /// One optional line beside the preset, at most 280 letters (org-profile Q19).
  promiseNote   String?       @db.Text

  /// The published look (storefront-themes D1, D11): keys into code, parsed on read, so a key
  /// retired from code reads as unthemed. Null theme is today's pages (Q19). `lookVersion` is
  /// what a publish compares-and-sets on (Q31); the previous look is kept until
  /// `previousLookUntil` so "Switch back" works for 30 days (Q4).
  themeKey              String?
  paletteKey            String?
  /// The shop's heading face (storefront-font D3, Q7): a key into code, parsed on read; null is the theme's own.
  fontKey               String?
  lookVersion           Int       @default(0)
  lookPublishedAt       DateTime?
  lookPublishedByUserId String?
  lookPublishedBy       User?     @relation("OrgLookPublishedBy", fields: [lookPublishedByUserId], references: [id], onDelete: Restrict)
  previousThemeKey      String?
  previousPaletteKey    String?
  previousFontKey       String?
  previousLookUntil     DateTime?

  /// What the themed page's editor writes (storefront-themes D13): the hero's one line, up to three
  /// claim keys from the shop's list (Q21), opening hours, and the themed sections it hides. Json
  /// is parsed on read. `contentEditedByUserId` names who saved it last, for "Changed by {Name}" —
  /// only while `contentEditedAt` equals `updatedAt`, since Shop details and look saves share the version.
  heroLine                 String?
  claims                   Json?
  openingHours             Json?
  storefrontHiddenSections Json?
  contentEditedByUserId    String?
  contentEditedBy          User?   @relation("OrgStorefrontContentEditedBy", fields: [contentEditedByUserId], references: [id], onDelete: Restrict)
  contentEditedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lookPublishedByUserId])
  @@index([contentEditedByUserId])
}

/// A photo or a picked category a themed page draws (storefront-themes D13, Q10): the hero's up
/// to three photos, the collections' up to six categories. A row, not a Json list, so a photo's
/// use stays a query over a referencing column (ADR-0058).
model OrgStorefrontSlot {
  id         String             @id @default(cuid())
  orgId      String
  org        Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind       StorefrontSlotKind
  position   Int
  categoryId String?
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assetId    String?
  asset      MediaAsset?        @relation("StorefrontSlotImage", fields: [assetId], references: [id], onDelete: Restrict)
  /// The phone version and how each is framed (image-slots trd D2, D10).
  phoneAssetId String?
  phoneAsset   MediaAsset?      @relation("StorefrontSlotPhoneImage", fields: [phoneAssetId], references: [id], onDelete: Restrict)
  imageFraming Json?
  createdAt  DateTime           @default(now())

  @@unique([orgId, kind, position])
  @@index([categoryId])
  @@index([assetId])
  @@index([phoneAssetId])
}

enum StorefrontSlotKind {
  HERO
  COLLECTION
}

/// Mirrored by `RETURNS_PRESET` in server/catalog/shop-details.types.ts.
enum ReturnsPreset {
  STANDARD
  EXCHANGE_7_DAY
  NO_RETURNS
}

/// The private listing context that does not belong to a brand (org-profile spec R4): what a
/// product inherits when neither it nor its family nor its brand says otherwise. Pre-fills,
/// never validates. The tax rate is basis points, never a float.
/// `amazonGeneric` now serves only a product with no brand and no default brand (dynamic-form Q14).
model OrgListingDefaults {
  orgId String @id
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  countryOfOrigin   String?
  taxRateBps        Int?
  /// Tax code per category id the org sells in.
  taxCodeByCategory Json?
  /// The shop's brand is not registered on Amazon, so a listing it creates there goes out as
  /// Amazon's "Generic", unbranded and with no barcode (setup-requests Q35). Never another
  /// shop's brand: listing under a brand one does not own is what gets an Amazon account suppressed.
  amazonGeneric     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A brand an organisation sells, with the facts that belong to the brand rather than the
/// shop: who makes it, who packs or imports it, where it comes from (org-profile spec R3). A
/// manufacturer has one; a shop carrying others' brands has many. Retired, never deleted (R9, ADR-0032).
model Brand {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name             String
  manufacturer     String?
  packerOrImporter String?
  countryOfOrigin  String?
  isDefault        Boolean @default(false)
  /// Registered on Amazon; false lists its products as Generic (listing-model Q10, attributes D6).
  amazonRegistered Boolean @default(true)
  parties          BrandParty[]

  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id     String  @id @default(cuid())
  code   String  @unique // "BB-1001"
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Delivery address (same for all shipments)
  address Json // OrderAddress
  notes   String? @db.Text

  // ✅ NEW: Order-level totals
  itemsTotal    Int @default(0) // paise
  shippingTotal Int @default(0) // paise
  discount      Int @default(0) // paise
  grandTotal    Int @default(0) // paise: itemsTotal + shippingTotal - discount

  // Payment (single for entire order)
  paymentMethod  String? // "razorpay"
  paymentStatus  String?   @default("pending") // pending, paid, failed
  paymentId      String? // the CONFIRMED gateway payment id — the idempotency key (payment-confirmation D2)
  /// When the money became real: stamped by `confirmPaid`, the clock the packing nudges run on (order-fulfilment D18).
  paidAt         DateTime?
  gatewayOrderId String? // the gateway order this order was charged through; created with amount = grandTotal

  // Overall order status. The values live in ORDER_STATUS
  // (server/checkout/order.types.ts) — "expired" means an abandoned checkout whose
  // reservation has been released, kept for follow-up and hidden from every panel.
  status String @default("processing")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  shipments      Shipment[]
  shippingEvents ShippingEvent[]

  /// One row per offer that touched this order, carrying who funded it (ADR-0019).
  /// `discount` above is their sum — a display total, never an input to settlement.
  discounts      OrderDiscount[]
  ledgerEntries  OrgLedgerEntry[]
  refunds        Refund[]
  budgetReleases PromotionBudgetRelease[]

  @@index([userId])
  @@index([code])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt]) // the reconciliation sweep asks "pending and old"
  @@index([gatewayOrderId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Restrict: a sold product cannot be deleted out from under its order history
  // (order-and-cart-lines R2).
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity  Int
  unitPrice Int // paise — the price as it stood at purchase, from birth (ADR-0004)
  /// The picture as it stood at purchase (product-video R17/D19). Same kind of fact as
  /// `unitPrice`: written server-side at order creation, never updated, never accepted
  /// from a request body. Stores the URL rather than a media id, because the media row
  /// is exactly what gets deleted in the case this exists for. Nullable only for rows
  /// that predate the column — the backfill fills what it can, which is today's cover,
  /// not what those buyers saw.
  thumbnail String?

  /// This line's share of the buyer's discount, allocated by largest-remainder
  /// rounding so per-line shares sum to the scope total exactly (ADR-0019).
  discountPaise  Int @default(0)
  /// How much of `discountPaise` the org bore; the platform bore the remainder.
  /// Persisted per line rather than only per offer because the ledger's commission
  /// base is `unitPrice * quantity - orgFundedPaise` **per line**, and rates resolve
  /// per line too (org-payouts D4c). Deriving it at settlement time would mean
  /// re-running the offer engine against a catalogue that has since moved.
  orgFundedPaise Int @default(0)

  // The chosen variant. Nullable: products without options have neither.
  size  String?
  color String?

  shipmentItems ShipmentItem[]
  ledgerLines   OrgLedgerEntryLine[]

  @@index([orderId])
  @@index([productId])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Cascade with the order line: the link is meaningless without it, and an
  // OrderItem only ever dies with its whole order.
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity Int

  @@index([shipmentId])
  @@index([orderItemId])
}

model Shipment {
  id   String @id @default(cuid())
  code String @unique // "BB-1001-SH1", "BB-1001-SH2"

  // Parent order
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The pre-PR-43 blob, kept one release as the audit copy of the lift. Read by
  // nothing; lines live in ShipmentItem rows (order-and-cart-lines trd.md).
  legacyItems Json?          @map("items")
  items       ShipmentItem[]

  // ✅ Origin details (where it ships from)
  orgId        String
  org          Org         @relation(fields: [orgId], references: [id])
  /// The pickup location this parcel was allocated from (stock-locations D5/D6).
  /// Nullable: pre-existing shipments keep NULL rather than a guessed attribution.
  /// The from* columns below stay as the historical snapshot — editing a location's
  /// address must never rewrite where a delivered parcel came from (A5).
  orgAddressId String?
  orgAddress   OrgAddress? @relation(fields: [orgAddressId], references: [id], onDelete: Restrict)
  fromPincode  String
  fromCity     String
  fromState    String

  // ✅ Shipping details (specific to this shipment)
  shippingCost       Int // paise
  shippingProviderId String?
  shippingProvider   ShippingProvider? @relation(fields: [shippingProviderId], references: [id])

  // ✅ Tracking (independent per shipment)
  /// The AWB. Unique where present: a partial index in the migration (order-fulfilment D11).
  trackingNumber String?
  courierName    String? // "BlueDart Surface"
  trackingUrl    String?
  /// Shiprocket's label link, pasted at booking (Q23). Served only through the shop's label route (D7, Q26).
  labelUrl       String?
  /// The day the courier collects, as the admin booked it (Q6). A calendar day, not a moment.
  pickupDate     DateTime? @db.Date

  // ✅ Status (independent per shipment)
  /// One of SHIPMENT_STATUS (server/shipping/domain/shipping.types.ts). Written only by
  /// shipment-status.service.ts, which the transition table guards.
  status            String    @default("packing")
  shipmentStatus    String? // Provider-specific status
  /// The day the buyer is told it arrives by (Q6). A calendar day, not a moment.
  estimatedDelivery DateTime? @db.Date
  deliveredAt       DateTime?
  /// When this parcel's units were returned to stock. The idempotency marker for restocking:
  /// a courier repeating a terminal event must not credit the same units twice
  /// (docs/specs/shipment-lifecycle/ D7).
  restockedAt       DateTime?

  // Package details
  packageWeight     Float?
  packageDimensions Json? // {length, width, height}

  // Metadata
  shippingMeta Json? // Provider-specific data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shippingEvents ShippingEvent[]
  ledgerEntries  OrgLedgerEntry[]
  parcelEvents   ParcelEvent[]
  notices        Notice[]
  refund         Refund?
  budgetReleases PromotionBudgetRelease[]

  @@index([orderId])
  @@index([orgId])
  @@index([status])
  @@index([trackingNumber])
}

model ShippingProvider {
  id          String  @id @default(cuid())
  code        String  @unique // 'shiprocket', 'delhivery', 'bluedart', etc.
  name        String // Display name: "Shiprocket", "Delhivery"
  description String? @db.Text // Provider description

  priority Int @default(0) // Higher number = higher priority

  // Authentication & Connection Status
  isConnected    Boolean   @default(false) // Is account connected?
  connectedAt    DateTime? // When was it connected?
  connectedBy    String? // Admin user ID who connected it
  connectionType String    @default("email_password") // [ 'email_password', 'api_key', 'oauth' ]
  lastAuthAt     DateTime? // Last successful authentication
  authError      String?   @db.Text // Last auth error message

  // Encrypted sensitive data
  authToken      String?   @db.Text // Encrypted JWT token
  tokenExpiresAt DateTime? // Token expiry timestamp

  // Account info (includes encrypted password)
  accountInfo Json? // {
  //   email: string,
  //   password: string (encrypted),
  //   firstName: string,
  //   lastName: string,
  //   companyId: number,
  //   warehousePincode?: string
  // }

  // Capabilities
  paymentOptions String[] // ['prepaid', 'cod']
  deliveryModes  String[] // ['air', 'surface']
  features       Json? // {tracking: true, label: true, scheduling: true}

  // Metadata
  logoUrl    String? // Provider logo
  websiteUrl String? // Provider website

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments Shipment[]
  rateCache ShippingRateCache[]
  events    ShippingEvent[]

  @@index([isConnected])
  @@index([code])
}

// Caches shipping rates to reduce API calls and improve performance
model ShippingRateCache {
  id String @id @default(cuid())

  // Provider reference
  providerId String
  provider   ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Rate calculation parameters
  fromPincode String
  toPincode   String
  weight      Float // in kg
  mode        String // 'prepaid', 'cod'

  // Cached rate information
  rate          Int // paise
  courierName   String // Courier service name
  estimatedDays Int // Estimated delivery days

  // Additional metadata
  metadata Json? // Any additional provider-specific data

  // Cache management
  expiresAt DateTime // When this cache entry expires
  createdAt DateTime @default(now())

  @@unique([providerId, fromPincode, toPincode, weight, mode])
  @@index([expiresAt])
  @@index([fromPincode])
  @@index([toPincode])
}

// Tracks all shipping-related events for debugging and analytics
/// One row per parcel move: the timeline all three readers see (order-fulfilment D5).
/// Written only in the transaction that moved the parcel. Not money: it goes with its parcel.
model ParcelEvent {
  id                String    @id @default(cuid())
  shipmentId        String
  shipment          Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// One of PARCEL_EVENT_KIND (server/shipping/domain/shipping.types.ts): a move, or a date change (D5).
  kind              String    @default("move")
  fromStatus        String?
  toStatus          String
  /// One of PARCEL_ACTOR (server/shipping/domain/shipping.types.ts).
  actor             String
  reason            String?
  /// The courier's own wording, when a courier caused it.
  courierWording    String?
  /// The dates a booking or a date change set (kind `move` into pickup_booked, or `pickup_moved`).
  pickupDate        DateTime? @db.Date
  estimatedDelivery DateTime? @db.Date
  /// The staff member's name at the time, for "Already booked by {name}" (ux.md admin book pickup).
  actorName         String?
  createdAt         DateTime  @default(now())

  @@index([shipmentId, createdAt])
}

/// One email about one parcel, written in the transaction that earned it and sent by the worker
/// (order-fulfilment D8). The unique key is what makes a repeated move or sweep email once.
model Notice {
  id         String    @id @default(cuid())
  shipmentId String
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// One of NOTICE_KIND (server/notifications/notice.types.ts).
  kind       String
  /// One of NOTICE_AUDIENCE: who it is for, so a changed shop email cannot send it twice.
  audience   String
  /// The address resolved when the notice was written.
  recipient  String
  /// What the email says, captured at the time; parsed by kind before sending.
  data       Json
  /// What makes a repeatable kind unique: the timeline row a date change wrote; "" for once-per-parcel kinds.
  ref        String    @default("")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([shipmentId, kind, audience, ref])
}

/// A courier update we could not apply: an AWB no parcel carries, or a move on a cancelled parcel
/// (order-fulfilment D10, R8). Recorded and answered 200, so it is seen rather than retried; the
/// admin reads and dismisses it. No foreign key: an unknown AWB has no parcel to point at.
model CourierConflict {
  id              String    @id @default(cuid())
  /// One of COURIER_CONFLICT_KIND (server/shipping/domain/shipping.types.ts).
  kind            String
  /// The carrier's code, e.g. "shiprocket".
  provider        String
  awb             String
  /// The cancelled parcel, when there is one; its code is copied for the row's wording.
  shipmentId      String?
  parcelCode      String?
  courierWording  String
  /// The body as it arrived, behind "Show details".
  payload         Json
  dismissedAt     DateTime?
  dismissedByName String?
  createdAt       DateTime  @default(now())

  @@index([dismissedAt, createdAt])
  @@index([awb])
}

model ShippingEvent {
  id String @id @default(cuid())

  // Order reference
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Shipment reference
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Provider reference
  providerId String
  provider   ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Event details
  eventType String // 'rate_check', 'shipment_created', 'status_update', 'cancellation'
  status    String // 'success', 'failed', 'pending'

  // Request/Response logging (for debugging)
  request  Json? // API request payload
  response Json? // API response

  // Error tracking
  errorMessage String? @db.Text
  errorCode    String?

  // Metadata
  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([shipmentId])
  @@index([providerId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

// Admin activity logging
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  // Restrict, not Cascade: deleting an admin must never erase the audit trail of
  // what they did — that is the record you want most when removing one. Block or
  // deactivate the account instead (User.isBlocked).
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String // e.g., "USER_BLOCKED", "PRODUCT_UPDATED"
  resource   String // e.g., "User", "Product", "Order"
  resourceId String // ID of the affected resource
  metadata   Json? // Additional details about the action
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([resource])
  @@index([action])
  // A product's team edits, newest first (product-form D13).
  @@index([resource, resourceId])
}

/// What a person may do inside one org. Declared here rather than as a TypeScript
/// union so there is exactly one declaration and the database rejects anything else —
/// unlike `ProductFlag`, which is a TS enum over a `String[]` because Postgres arrays
/// of enums are awkward. A role is scalar, so it does not need that compromise.
enum OrgRole {
  OWNER
  STAFF
}

/// A person's membership of an org. The relationship carries the role, because a role
/// on `User` could not express "owner of A, staff at B".
///
/// Cascade on both sides is deliberate: a membership is meaningless without either end,
/// and deleting one end must remove only the link — never the other party.
/// A selling organisation's pickup location (stock-locations D1/D10): the org's
/// relationship to a postal Address — courier nickname, who answers the door at
/// pickup, and the aggregator registration designed for but not built (D11).
/// Restrict both ways: an org with locations, or a location an Address underpins,
/// cannot be deleted out from under the other.
/// A handle this org used to hold.
///
/// Kept forever rather than deleted at expiry: the hold is *derived* by comparing
/// `retiredAt` against the window, so nothing has to run for the answer to be right
/// (ADR-0023's shape). While held the handle redirects here and no other org may take
/// it; past the window it stops doing both. Taking a handle back deletes its rows, or
/// the old address would redirect away from the shop now living at it (ADR-0030).
model OrgHandleHistory {
  id     String @id @default(cuid())
  handle String
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  retiredAt DateTime @default(now())

  /// Not unique on `handle` alone: an org may leave a handle, take it back, and leave
  /// it again, which is two rows for one string.
  @@index([handle, retiredAt])
  @@index([orgId])
}

/// A promotion an org runs across the top of its own storefront.
///
/// Rendered through the platform's own hero, so a shop's promotion and the platform's
/// look alike. Distinct from `Org.heroUrl`, which is the shop's static cover image.
///
/// Deliberately not `orgId` on `Banner`: that table is the platform's home page, and
/// "an org's promotion never reaches it" (storefront-branding R2d) is a rule worth
/// making structural rather than a where-clause every future query has to remember.
model OrgBanner {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Optional: a promotion can be the picture alone.
  title        String?
  description  String?
  /// Through the optimizer, like every other image (ADR-0026).
  imageUrl     String?
  imageAssetId String?
  imageAsset   MediaAsset? @relation("OrgBannerImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  imageAlt     String?
  /// The phone version and how each is framed (image-slots trd D2): the URL beside its asset, framing
  /// parsed on read by `server/catalog/image-framing.ts`, never cast.
  phoneImageUrl     String?
  phoneImageAssetId String?
  phoneImageAsset   MediaAsset? @relation("OrgBannerPhoneImage", fields: [phoneImageAssetId], references: [id], onDelete: Restrict)
  imageFraming      Json?

  /// Where it points — always inside this org's own storefront (R2c), enforced in the
  /// schema that parses it rather than by the column's type.
  href String?

  /// Server-owned: a create appends, only a reorder rewrites it.
  order    Int     @default(0)
  /// Taken down, not deleted, so a campaign can run again next season (R2b).
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, isActive, order])
}

model OrgAddress {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  name         String // courier pickup nickname — "Bhendi Bazaar shop", "Bhiwandi godown"
  contactName  String // '' until a human completes it; required if fulfilment books real pickups
  contactPhone String
  isActive     Boolean @default(true)
  /// Aggregator pickup-location reference (D11): carried, read by nothing yet.
  providerRef  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productStock     ProductStock[]
  shipments        Shipment[]
  channelLocations ChannelLocation[]

  @@index([orgId])
}

/// Where a product's units physically sit (stock-locations D2): the quantity lives
/// on the join row, because a location without a quantity is a place the store
/// cannot honour a quote from. Restrict on the location side is R8 in the database.
model ProductStock {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orgAddressId String
  orgAddress   OrgAddress @relation(fields: [orgAddressId], references: [id], onDelete: Restrict)
  quantity     Int

  @@id([productId, orgAddressId])
  @@index([orgAddressId])
}

model OrgMember {
  id     String  @id @default(cuid())
  userId String
  orgId  String
  role   OrgRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Whether a person runs the platform. Distinct in kind from `OrgRole`: there is exactly
/// one platform, so this is a property of the person, whereas a role inside an org is a
/// property of a relationship. Kept an enum rather than a boolean because a read-only
/// support role is a plausible third value.
enum PlatformRole {
  USER
  ADMIN
}

/// A category's accent, stored as a semantic key and mapped to classes at render
/// (`src/lib/category-accent.ts`). Rows used to hold raw Tailwind class strings —
/// presentation frozen into the database, which broke the moment the classes moved.
enum CategoryAccent {
  EMERALD
  BLUE
  PURPLE
  PINK
  ORANGE
  YELLOW
  RED
  GRAY
}

/// A postal fact, identity-agnostic (addresses-as-entities D1/D2): who receives there
/// lives on the owning relationship (`UserAddress` now, `OrgAddress` when
/// stock-locations lands). No uniqueness on purpose — free text does not normalise,
/// and a shared row would force copy-on-write on every edit.
model Address {
  id           String  @id @default(cuid())
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  /// Provenance, not ownership — nullable so seeds and system rows are honest.
  createdBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAddresses UserAddress[]
  orgAddresses  OrgAddress[]

  @@index([pincode])
}

/// A person's relationship to an address: their label for it, and who receives there
/// (not necessarily the account holder). No `isDefault` by decision — the buyer picks
/// at checkout.
model UserAddress {
  id        String  @id @default(cuid())
  userId    String
  addressId String
  label     String?
  fullName  String
  phone     String
  email     String?
  notes     String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Promotions — offers the platform and its orgs can run
// (docs/specs/promotions/, ADR-0018, ADR-0019, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// Who funds an offer. Genuinely two-valued and staying so, which is why it is an
/// enum while *what an offer covers* is a table (promotions D2).
enum PromotionScope {
  PLATFORM
  ORG
}

/// How an offer activates. AUTOMATIC offers set the price shown on a product page,
/// so they may carry no basket-level condition; CODE offers are entered at checkout,
/// where the basket is known, and may (promotions D5).
enum PromotionTrigger {
  AUTOMATIC
  CODE
}

/// PERCENT and AMOUNT_OFF reduce; FIXED_PRICE sets an outright selling price, which
/// is what a per-product markdown means and what a percentage cannot express
/// (promotions D4/D9). FIXED_PRICE is only legal on a product-targeted offer.
enum PromotionValueType {
  PERCENT
  AMOUNT_OFF
  FIXED_PRICE
}

/// A time-boxed offer. Three independent axes: who funds it (`scope`), how it
/// activates (`trigger`), and what it covers (`targets` — zero rows means everything
/// in scope, promotions D3).
///
/// Constraints the schema language cannot express are added as raw SQL in the
/// migration: scope/orgId agreement, trigger/code agreement, a value matching its
/// type, and endsAt after startsAt.
model Promotion {
  id    String @id @default(cuid())
  /// Shown to the buyer on the line badge and frozen onto OrderDiscount at purchase.
  label String

  scope PromotionScope
  /// Set iff scope = ORG. Restrict: an org with campaign history is not deletable.
  orgId String?
  org   Org?           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  trigger PromotionTrigger
  /// Set iff trigger = CODE. Globally unique — a buyer types one string and it must
  /// resolve to exactly one offer. Org codes carry the org's own code as a prefix
  /// (promotions D13), which makes collisions impossible rather than merely reported.
  code    String?          @unique

  valueType       PromotionValueType
  /// Basis points — 2000 = 20%. Integer, so no float reaches the money path (ADR-0004).
  percentBps      Int?
  amountOffPaise  Int?
  fixedPricePaise Int?

  /// CODE offers only (promotions D5): a product page cannot know the basket.
  maxDiscountPaise Int?
  minSubtotalPaise Int  @default(0)

  /// Every offer is time-boxed — no offer runs indefinitely (spec R4).
  startsAt DateTime
  endsAt   DateTime
  /// The kill switch, independent of the window: a mispriced sale must die in one
  /// click, not a date edit (spec R5).
  isActive Boolean  @default(true)

  /// A CODE offer the shop ticked "Show on my shop" (storefront-themes Q20). Automatic offers
  /// show on the shop's deals section regardless; a public code is used by strangers, so off by default.
  showOnStorefront Boolean @default(false)

  /// Enforced with a conditional update inside the order transaction (promotions D11,
  /// ADR-0007). Read-then-write oversells a coupon exactly as it oversells stock.
  usageLimit   Int?
  usageCount   Int  @default(0)
  perUserLimit Int?

  /// What a PLATFORM offer may cost the platform in total; spent by a conditional write in
  /// the order transaction and given back on expiry (offers-hardening D5).
  platformBudgetPaise   Int?
  platformSpentPaise    Int       @default(0)
  /// Set when an admin confirmed an offer that can cost more than commission (D6, own-store Q20).
  lossConfirmedAt       DateTime?
  lossConfirmedByUserId String?
  lossConfirmedBy       User?     @relation("PromotionLossConfirmedBy", fields: [lossConfirmedByUserId], references: [id], onDelete: Restrict)

  targets        PromotionTarget[]
  orderDiscounts OrderDiscount[]
  budgetReleases PromotionBudgetRelease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([scope, orgId])
  @@index([trigger])
}

/// What an offer covers. Exactly one dimension per row; zero rows on a promotion
/// means "everything in scope" (promotions D3), which is why these **restrict**
/// their category and product: a cascade would remove an offer's only target and
/// silently widen it store-wide (promotions D3a, ADR-0020).
///
/// Cascade on `promotionId` is composition, not reference — the same distinction
/// `OrderItem` already draws between its order and its product.
model PromotionTarget {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  /// A category target covers its whole subtree (promotions spec R2).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([promotionId, categoryId])
  @@unique([promotionId, productId])
  @@index([categoryId])
  @@index([productId])
}

/// One offer's effect on one order, with its cost divided between the two parties
/// who could have paid for it (ADR-0019). `orgFundedPaise + platformFundedPaise =
/// buyerDiscountPaise` is asserted by a CHECK in the migration, so no settlement can
/// be computed from a split that does not reconcile.
///
/// Restricts both its promotion and its order: this row is the attribution a payout
/// reads, and it must outlive any tidying of either (ADR-0020).
model OrderDiscount {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  /// Whose lines this concerns. Always set — a platform offer still lands on some
  /// org's goods, and the ledger needs to know whose.
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Frozen at purchase, so a renamed or reworded offer cannot rewrite a receipt —
  /// the same reasoning that froze `thumbnail` onto OrderItem.
  labelSnapshot String
  codeSnapshot  String?

  buyerDiscountPaise  Int
  orgFundedPaise      Int
  platformFundedPaise Int
  /// What this row charged the offer's budget (offers-hardening D5) — 0 when it had none, so
  /// expiry gives back exactly what was taken, whatever the budget became since.
  budgetChargedPaise  Int @default(0)

  createdAt DateTime @default(now())

  @@unique([orderId, promotionId, orgId])
  @@index([promotionId])
  @@index([orgId])
}

/// One release of a platform offer's budget (order-fulfilment D13, Q10, Q33): a parcel's share on
/// cancel, or the order's whole charge on expiry. Its unique keys are what make a repeat cancel or
/// a later expiry give nothing back twice — (shipmentId, promotionId) here, and (orderId,
/// promotionId) where shipmentId is null, a partial index in the migration.
model PromotionBudgetRelease {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Null for an expiry's order-level release.
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  amountPaise Int
  createdAt   DateTime  @default(now())

  @@unique([shipmentId, promotionId])
  @@index([orderId])
  @@index([promotionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payouts — what each org earned, what the platform kept, what is still owed
// (docs/specs/org-payouts/, ADR-0019, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// SALE is written from the paid transition; REVERSAL offsets one; ADJUSTMENT is a
/// manual line the order flow does not produce — a reimbursement, a penalty
/// (payouts D6, spec R5).
enum LedgerEntryKind {
  SALE
  REVERSAL
  ADJUSTMENT
  /// A shop cancelled a paid parcel (order-fulfilment D14): payable = −fee, one per parcel (partial unique).
  CANCELLATION_FEE
}

/// What gates editing (payouts D6). DRAFT is editable; once its settlement is paid
/// the entry is SETTLED and its figures are fixed, because it now records a transfer
/// that actually happened.
enum LedgerEntryState {
  DRAFT
  SETTLED
  REVERSED
}

/// How money moved outside the platform (shop-credits D6): a top-up in, a payout out.
enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  OTHER
}

enum CreditLineKind {
  /// The one-time starting credit (ai-images Q14).
  GRANT
  /// Money the shop paid the platform offline, recorded by the admin with proof (Q17).
  TOP_UP
  /// An AI picture, charged when asked for (shop-credits D5).
  CHARGE
  /// The difference when a fallback model answered at another price.
  ADJUSTMENT
  /// A picture that was not made: what its charge and adjustment netted to, given back (Q20).
  REFUND
  /// An admin correcting a line; the original stays.
  REVERSAL
}

/// A shop's credit, as append-only lines (ai-images/shop-credits D2). The balance is their sum and
/// is never stored (R1); a line is never edited or deleted (R4). Restrict: money never cascades (ADR-0020).
model CreditLine {
  id                String         @id @default(cuid())
  orgId             String
  org               Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  kind              CreditLineKind
  /// Signed integer paise: a credit is positive, a charge negative (Invariant 3).
  amountPaise       Int
  /// A charge's provider cost and the margin applied to it, beside what was charged (Q15).
  providerCostPaise Int?
  marginBps         Int?
  /// The run a charge, adjustment or refund belongs to.
  enhancementId     String?
  /// One line per kind per run, so a retried settle or refund changes nothing (D5).
  runKey            String?        @unique
  /// The org id on its one GRANT line, so a shop is granted once (D3).
  grantKey          String?        @unique
  method            PaymentMethod?
  reference         String?
  paidOn            DateTime?      @db.Date
  receiptRef        String?
  /// The line a REVERSAL undoes; unique, so a line is reversed at most once.
  reversesId        String?        @unique
  reverses          CreditLine?    @relation("CreditReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy        CreditLine?    @relation("CreditReversal")
  note              String?
  /// Who recorded it; null for a line the platform wrote itself (grant, charge).
  createdByUserId   String?
  createdAt         DateTime       @default(now())

  @@index([orgId, createdAt])
  @@index([enhancementId])
}

/// The platform's margin on AI pictures, in basis points (Q15). One row, addressed by a constant id.
model CreditSettings {
  id        String   @id @default("platform")
  marginBps Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// One shop's margin where it differs from the platform's; no row, or null, means the platform's.
model OrgCreditPolicy {
  orgId     String   @id
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  marginBps Int?
  updatedAt DateTime @updatedAt
}

/// Where a shop sends a top-up (Q35): the platform's UPI id, QR code and bank account. One row.
model PlatformPaymentDetails {
  id              String   @id @default("platform")
  upiId           String?
  qrRef           String?
  accountName     String?
  accountNumber   String?
  ifsc            String?
  bankName        String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED
}

/// An org's commission rate for a category, overriding its default. Nearest ancestor
/// wins, so a rate on a parent means "unless a child says otherwise" with no
/// precedence field to configure (payouts D4a/D4b).
///
/// Restricts its category: a cascade here would silently move an org onto a
/// different rate (ADR-0020).
model OrgCommissionRule {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  rateBps Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, categoryId])
  @@index([orgId])
  @@index([categoryId])
}

/// One org's share of one order, written when the order is paid — never when it is
/// placed, so an order that never pays never appears in a payout (payouts D5).
///
/// `commissionBase = grossItemsPaise - orgFundedDiscountPaise`: commission is charged
/// on what the org's goods earned after the org's own discount, and before any
/// discount the platform chose to fund. Basing it on what the buyer paid would
/// quietly make the org co-fund the platform's campaign (payouts D2).
///
/// No rate column: rates resolve per item, so one entry can carry several and the
/// rate lives on the line (payouts D4c).
model OrgLedgerEntry {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Null for a manual adjustment, which has no order behind it (spec R5).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// The parcel a REVERSAL undoes (offers-hardening D1). Null on a SALE, an adjustment, and a
  /// reversal written order-wide before parcels carried their own.
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  kind  LedgerEntryKind  @default(SALE)
  state LedgerEntryState @default(DRAFT)

  grossItemsPaise             Int
  orgFundedDiscountPaise      Int
  /// Informational: excluded from the base, shown as the platform's campaign cost
  /// against this order (payouts D2, spec R17).
  platformFundedDiscountPaise Int
  commissionBasePaise         Int
  commissionPaise             Int
  /// Signed, so a REVERSAL is the same shape with the opposite sign (payouts D6).
  payablePaise                Int

  /// Raised on write rather than found in a reconciliation (payouts D12). True when
  /// the platform funded more than it earned on this entry.
  isNegativeMargin Boolean   @default(false)
  /// A figure that no longer derives from its order should not look like one that
  /// does (payouts D9b).
  isManuallyEdited Boolean   @default(false)
  /// Soft delete: a hard one would drop money out of a balance leaving nothing to
  /// explain the change (payouts D9a).
  deletedAt        DateTime?

  note String?

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  lines OrgLedgerEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uniqueness is three partial indexes in the migration (offers-hardening D1): one SALE per
  // order and org, one legacy order-wide REVERSAL per order and org, one REVERSAL per parcel.
  @@index([shipmentId])
  @@index([orderId, orgId])
  @@index([orgId, deletedAt])
  @@index([settlementId])
  @@index([isNegativeMargin])
}

/// One order line's contribution to an entry, carrying the rate that actually
/// applied to it (payouts D4c). Cascade on the entry is composition; Restrict on the
/// order line is a reference to another aggregate — the same split `OrderItem` draws
/// between its order and its product.
model OrgLedgerEntryLine {
  id      String         @id @default(cuid())
  entryId String
  entry   OrgLedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Null for a manual adjustment's line.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  basePaise       Int
  rateBps         Int
  commissionPaise Int
  /// Units a parcel reversal undid on this line. Null on a sale, and on an order-wide reversal,
  /// which counts as the whole line (offers-hardening Q6).
  quantity        Int?

  @@index([entryId])
  @@index([orderItemId])
}

/// A batch of entries the platform has paid, or intends to. Free-form over whatever
/// is unsettled — no period and no schedule, because a transfer is decided when it
/// suits and a period column would only describe which entries happened to be picked
/// (payouts D7).
model Settlement {
  id    String @id @default(cuid())
  code  String @unique
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  amountPaise Int
  status      SettlementStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?
  note        String?
  /// How the transfer was made, and a picture of its receipt (ai-images/shop-credits D6, Q18).
  method      PaymentMethod?
  receiptRef  String?

  /// Restrict, as `AdminLog` already does: removing a person must never erase the
  /// record of what they authorised.
  createdByUserId String
  createdBy       User    @relation("SettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String?
  updatedBy       User?   @relation("SettlementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  entries OrgLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([code])
}

/// What a shop's cancellation costs it, editable without a deploy (order-fulfilment D14, Q20, Q29).
/// One row, seeded at ₹50 by its migration; `version` is the compare-and-set a second admin's save
/// is refused on. The fee charged is copied onto each ledger entry, so an edit never rewrites history.
model FulfilmentSettings {
  id                   String   @id @default("default")
  cancellationFeePaise Int      @default(5000)
  version              Int      @default(0)
  /// Who saved it last, copied at the time ("Last changed by {name}, {date}"); the audit log holds the rest.
  updatedByName        String?
  updatedAt            DateTime @updatedAt
}

/// What a refund moves through (order-fulfilment D16, D17). U5 writes OWED; the button (U6) the rest.
enum RefundState {
  OWED
  REQUESTED
  STARTED
  UNCONFIRMED
  FAILED
}

/// The refund one parcel is owed (order-fulfilment D16, Q11, Q25), one per parcel, or one late payment (unmatched-payments). The amount is
/// the server's — the parcel's lines less their discount share, plus its shipping — capped so an
/// order's rows never pass what was captured. Money-bearing, so nothing cascades (ADR-0020), and
/// `Order.paymentStatus` is never touched by it.
model Refund {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Null for a payment captured after its order was released (unmatched-payments D3).
  shipmentId      String?     @unique
  shipment        Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  /// The payment refunded when it is not the order's own; unique, so a repeated capture records once.
  gatewayPaymentId String?    @unique
  amountPaise     Int
  /// The parcel state that made it owed: one of REFUND_CAUSE (server/payments/refund.types.ts).
  cause           String
  state           RefundState @default(OWED)
  /// The gateway's refund id once started (U6), and its refusal when it refused.
  gatewayRefundId String?
  failureReason   String?
  requestedAt     DateTime?
  startedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([state, createdAt])
  @@index([orderId])
}

/// The storefront's hero banners. Platform-owned shelf space: an org promoting its own
/// products is what offers are for.
model Banner {
  id           String         @id @default(cuid())
  /// Optional like every other word on a banner: artwork that carries its own
  /// typography needs no headline laid over it.
  title        String?
  eyebrow      String?
  description  String?
  /// Blob URL. Null renders the brand gradient scene rather than a blank box.
  imageUrl     String?
  imageAssetId String?
  imageAsset   MediaAsset?    @relation("BannerImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  imageAlt     String?
  /// The phone version and how each is framed (image-slots trd D2). The URL is kept beside the id so
  /// the cached home read never joins MediaAsset (ADR-0065).
  phoneImageUrl     String?
  phoneImageAssetId String?
  phoneImageAsset   MediaAsset? @relation("BannerPhoneImage", fields: [phoneImageAssetId], references: [id], onDelete: Restrict)
  imageFraming      Json?
  /// Server-owned. A create appends to the end; only the reorder route rewrites it.
  order        Int            @default(0)
  /// Taken down, not deleted — the copy and artwork survive for the next run.
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  actions      BannerAction[]

  @@index([isActive, order])
}

/// Rows rather than JSON on Banner, so a label and a destination are columns the
/// database can constrain.
model BannerAction {
  id       String              @id @default(cuid())
  bannerId String
  /// Cascade is the correct side of ADR-0020: an action carries no money and no
  /// attribution, and has no meaning apart from its banner.
  banner   Banner              @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  label    String
  href     String
  variant  BannerActionVariant @default(PRIMARY)
  order    Int                 @default(0)

  @@index([bannerId, order])
}

enum BannerActionVariant {
  PRIMARY
  SECONDARY
}

// ─────────────────────────────────────────────────────────────────────────────
// BIDDING — one item sold by timed bidding on a shareable link
// (docs/specs/bidding/, ADR-0007, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// Only what the clock cannot decide (bidding D3). Whether an OPEN event is scheduled,
/// running or finished is derived from its timestamps on every read, so no scheduled job
/// has to have run for the answer to be right. Nothing may branch on this column alone.
enum BiddingStatus {
  OPEN
  CANCELLED
  SOLD
  UNSOLD
}

/// One item offered for timed bidding on a public link.
///
/// `highestBidPaise` and `bidCount` are derived, but written only inside the guarded
/// conditional update that accepts a bid (bidding D5/D7), so they are authoritative by
/// construction rather than by reconciliation — and they make the public page, which is
/// read far more often than it is written, a single row read.
///
/// Two constraints the schema language cannot express are raw SQL in the migration: a
/// partial unique index on `productId` where the status is OPEN, so a product is under
/// at most one live event and two simultaneous creations cannot both succeed (D4, R7);
/// and a check that the bidding window is ordered.
///
/// Restricts its product, org and people: an event carries money and attribution, so
/// deletion is refused and the real operation is cancellation (ADR-0020, R27).
model BiddingEvent {
  id   String @id @default(cuid())
  /// The public link's token — random, never the product slug, so the link is
  /// unguessable and independent of a slug frozen for other reasons (D16, R9).
  slug String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  startAt DateTime
  endAt   DateTime

  startingBidPaise    Int
  /// The most one bid may add to the current high. A bidder wanting to go further bids
  /// again, which caps a bad-faith bid without capping the auction (R6).
  maxIncreasePaise    Int
  /// The org's own quick-bid amounts, ascending. The smallest also floors a custom
  /// increase, so the buttons on screen cannot contradict the rule (R5, R13).
  quickBidsPaise      Int[]
  /// The product's price when the event opened, copied so later repricing cannot rewrite
  /// what the event says the item was worth (D9, R4).
  referencePricePaise Int

  status BiddingStatus @default(OPEN)

  highestBidPaise Int?
  bidCount        Int  @default(0)

  /// Written together when the platform records the outcome (R40, R43). The amount is
  /// what the org is owed and may differ from the winning bid, which is why the reason
  /// is kept beside it rather than inferred later.
  soldBidId       String?   @unique
  soldBid         Bid?      @relation("SoldBid", fields: [soldBidId], references: [id], onDelete: Restrict)
  soldAmountPaise Int?
  soldReason      String?   @db.Text
  settledAt       DateTime?
  settledById     String?
  settledBy       User?     @relation("BiddingSettledBy", fields: [settledById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("BiddingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  bids Bid[] @relation("EventBids")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the purchase-suspension lookup, which asks for OPEN events by product
  /// (D8/D8a) — the one query on the storefront's read path.
  @@index([status, productId])
  @@index([status, endAt])
  @@index([orgId, status])
}

/// One bid, kept for good: nothing is removed while an event runs, and the ladder is what
/// the platform works down when a winner does not go through with it (R27, R39).
///
/// A guest's details sit on the row, following the address snapshot already carried on
/// `Order` — there is no guest table. Email is nullable by decision: a bidder who gives
/// none cannot be told they were outbid, which the form discloses at the point of
/// choosing (D14, R22/R22a/R28). A check in the migration requires either a user or a
/// guest name and phone, so a bid is always attributable to someone.
///
/// Unique on `(eventId, amountPaise)`: the guarded update already makes equal bids
/// impossible, and this makes it impossible independently of that guard being written
/// correctly, so no tiebreak rule has to exist anywhere (D6, H1).
model Bid {
  id      String       @id @default(cuid())
  eventId String
  event   BiddingEvent @relation("EventBids", fields: [eventId], references: [id], onDelete: Restrict)

  amountPaise Int

  /// Set for a signed-in bidder, whose contact details are read through the relation so
  /// they cannot go stale. A guest fills the columns below instead — never both.
  userId     String?
  user       User?   @relation("UserBids", fields: [userId], references: [id], onDelete: Restrict)
  guestName  String?
  guestPhone String?
  guestEmail String?

  createdAt DateTime @default(now())

  wonEvent BiddingEvent? @relation("SoldBid")

  @@unique([eventId, amountPaise])
  @@index([eventId, amountPaise(sort: Desc)])
  @@index([userId])
}

/// A permitted answer to a listing fact (listing-vocabulary/categories D3, D5).
///
/// The facts are declared in code because they change with a release; the answers live here
/// because a colour grows the first time a shop sells one, and waiting for a deploy to add one is
/// the friction this phase exists to remove.
///
/// One list serves every product type that asks for it, rather than a list per type: Flipkart
/// copies its colour list per node and they have drifted — thirty-five values of which only
/// sixteen appear in every node (D5).
/// Carries an attributes sync trigger (attributes Q12): a value added or changed reaches AttributeOption.
model ListingValue {
  id String @id @default(cuid())

  /// Which list this belongs to — a `LIST` key from `server/catalog/listing-facts.ts`.
  list  String
  /// What is stored on a product. Renaming a label must not rewrite products, and two shops must
  /// not disagree about what maroon is (D4).
  key   String
  label String
  order Int    @default(0)

  /// The product types this answer applies to. Empty means every type that asks for its list,
  /// which is the common case — a colour is a colour.
  productTypes String[] @default([])

  /// Null for a platform-provided answer, visible to everyone. Set when a shop added its own, so
  /// one shop's vocabulary cannot quietly widen another's.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Retired rather than deleted: products already store this key, and a deleted answer would
  /// leave them reading as unlisted text ([ADR-0032](../docs/adr/0032-records-people-authored-are-retired-not-deleted.md)).
  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // A shop may add a key the platform later adds too; scoping the uniqueness to the owner keeps
  // both rows legal and lets the shop's own answer win for that shop.
  @@unique([list, key, orgId])
  @@index([list])
  @@index([orgId])
}

/// What a set of products that sell separately have in common (listing-vocabulary/variants R2).
///
/// An abaya in four colours is one family and four products. The family carries what the four
/// share — the description, the fabric, the measurements — and the fill step copies those onto
/// each member on save, so a member is read as one row and the family is never read to display
/// or publish a product (variants D10, listing-vocabulary trd D4).
///
/// **It holds no price, no stock and no `ProductStock`.** Spec R3 is enforced by the columns not
/// existing rather than by a check, which is the only way it cannot be forgotten: if a family
/// kept a stock number at all, something would eventually sell it and the real counts would not
/// move.
model ProductFamily {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  name        String
  /// Typed once here and copied onto each member on save; a member may override it (variants D10).
  description String? @db.Text

  /// The product type its members take, and the facts and measurements they inherit. Same shape
  /// as `Product.facts` so one fill step serves both.
  productType  String?
  facts        Json?
  measurements Json?

  /// Which facts make its members differ — a copy of the type's declared axis at the time the
  /// family was made, so reordering the declaration later cannot silently re-group a shop's
  /// products.
  variantAxis String[] @default([])

  /// Retired, never deleted ([ADR-0032](../docs/adr/0032-records-people-authored-are-retired-not-deleted.md)).
  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
  /// The family's own page on a marketplace, under which its members list (marketplace-publish D7).
  platformListings PlatformListing[]

  @@index([orgId])
  @@index([orgId, retiredAt])
}

/// A question set: which facts a product is asked, what it measures, what makes two of its
/// products sell separately, and which kinds it holds
/// ([product-types](../docs/specs/listing-vocabulary/product-types/) D1).
///
/// A row rather than a constant, so onboarding a seller with a line the platform has never
/// carried does not wait for a release (spec R1). What stays in code is the *vocabulary* — the
/// facts in `server/catalog/listing-facts.ts`, each carrying a validation rule and a way of
/// being answered. A type is a selection from it, and a selection is data. This is where Akeneo
/// and Shopify both draw the line.
///
/// Platform-wide, never per seller (D11): an admin defines types as an admin defines categories.
/// A seller inventing its own would fragment the mappings every channel adapter depends on. The
/// permitted *answers* stay org-scopeable (`ListingValue.orgId`) because a shop knowing a colour
/// the platform does not is harmless, where a shop knowing a different question set is not.
/// Carries an attributes trigger (attributes Q12): its questions are rebuilt in BbTypeAttribute.
model ProductType {
  id String @id @default(cuid())

  /// What `Product.productType` and `Category.productType` already store — `islamic-wear` and
  /// the rest. Unique so both columns can reference it, which lets every existing row keep the
  /// exact string it holds and simply gain integrity: no backfill, no id rewrite (D2).
  key   String @unique
  label String

  /// Fact keys from `server/catalog/listing-facts.ts`, in the order the form shows them. A key
  /// naming no declared fact is refused on write — a form field with no meaning is worse than a
  /// missing one (D3).
  facts String[] @default([])

  /// `[{ key, label, unit, required }]` — the measurements this type takes, with the unit fixed
  /// per type rather than chosen per product.
  measures Json?

  /// Which facts or measures make two of its products sell separately (variants D1). Declared
  /// per type because Flipkart declares its axes per node and no two of its twelve agree.
  variantAxis String[] @default([])

  /// `[{ key, label }]` — the kinds it holds. A kind decides which platform node a product maps
  /// to, which is why abaya, burqa and rida are kinds rather than types of their own.
  kinds Json?

  /// Where this type's trade uses another word for a shared fact — Flipkart asks cloth "Fabric"
  /// and everything else "Material", which is one question with two labels, not two facts.
  /// `{ "<factKey>": "<label>" }`.
  factLabels Json?

  /// Which measurements a size label is read from, and optionally the scale that turns one into
  /// a label — a ring's inner diameter becoming a ring size (D9). Nearest-match is generic code,
  /// so the scale is data and a type is fully configurable rather than half.
  labelFrom  String[] @default([])
  labelScale Json?

  /// Retired, never deleted ([ADR-0032](../docs/adr/0032-records-people-authored-are-retired-not-deleted.md)):
  /// products store its key, and the foreign keys refuse the delete anyway.
  retiredAt DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products   Product[]
  categories Category[]

  @@index([retiredAt])
}

/// Which channels a shop has turned on ([channel-registry](../docs/specs/channel-registry/) D2).
///
/// The channels themselves are declared in `server/shared/channels.ts`, not stored: one needs an
/// image rule, a readiness rule and an adapter before it can do anything, so a row an admin
/// could add would be a row that does nothing (D1). What a *shop* chooses is this.
///
/// **An absent row is off**, which is the default: a shop that has decided nothing is not warned
/// about anything (spec R9).
model OrgChannel {
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// A `CHANNEL` key. Not a foreign key, because the channels are declared rather than stored.
  channel String
  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([orgId, channel])
  @@index([channel])
}

/// What one shop may use of the paid features (subscriptions/feature-access D1). The one writer is
/// `server/subscriptions/org-feature.repository.ts`. **An absent row is locked** (Q14, Q15): a shop
/// has a feature only once the admin has switched it on. The home brand is never read (Q13).
model OrgFeature {
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// A `FEATURE` key. Not an enum, as `OrgChannel.channel`: a feature is declared in code.
  feature     String
  enabled     Boolean   @default(false)
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime  @default(now())

  @@id([orgId, feature])
  @@index([feature, enabled])
}

/// A shop's authorised connection to one marketplace (channel-connectors TRD D2). Tokens are
/// `server/shared/crypto.ts` ciphertext and never leave the channels domain. Disconnecting nulls them
/// and keeps who connected and when (decision Q4), so the row is retired, never deleted.
/// One connected row per marketplace account: a partial unique index in the migration (D9).
model ChannelConnection {
  id      String @id @default(cuid())
  orgId   String
  org     Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  /// A marketplace `CHANNEL` key.
  channel String
  /// `CONNECTION_STATE`: CONNECTED, NEEDS_RECONNECT, DISCONNECTED.
  state   String

  /// The marketplace's own id for the seller (Amazon's selling_partner_id). Flipkart gives none.
  externalAccountId     String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  /// When the seller last consented; Amazon asks again 365 days later.
  authorizedAt          DateTime?

  connectedById    String?
  connectedBy      User?     @relation("ChannelConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt      DateTime?
  disconnectedById String?
  disconnectedBy   User?     @relation("ChannelDisconnectedBy", fields: [disconnectedById], references: [id], onDelete: SetNull)
  disconnectedAt   DateTime?

  lastCheckedAt DateTime?
  /// A `CONNECTION_ERROR` code, never marketplace text.
  lastErrorCode String?
  lastErrorAt   DateTime?

  /// The listing read (channel-import D2). `READ_STATE`: RUNNING, DONE, STOPPED.
  readState      String?
  readTotal      Int?
  readDone       Int?
  readStartedAt  DateTime?
  readFinishedAt DateTime?
  /// Touched as a read makes progress; a RUNNING read silent for 30 minutes may be claimed again (D3).
  readTouchedAt  DateTime?
  /// A `READ_ERROR` code, never marketplace text.
  readErrorCode  String?

  /// Stock sync per marketplace (inventory-sync D6, Q4): off until the shop turns it on after the
  /// preview; paused stops every send and check. Sent and checked times are the section's line.
  stockSync          String    @default("off")
  stockSyncChangedAt DateTime?
  stockSentAt        DateTime?
  stockCheckedAt     DateTime?
  /// Where the next order check starts, as the marketplace understands it.
  ordersCursor       String?
  /// Claimed by each order check, so only one chain of checks runs (inventory-sync Q23).
  ordersCheckedAt    DateTime?
  /// The last problem a send met, `STOCK_PROBLEM`, cleared by the next send that goes (D7).
  stockProblem       String?

  /// A social channel's WhatsApp business account and phone number ids (social-selling meta-foundation);
  /// `externalAccountId` holds the Instagram account id. Events are routed by these, and each is unique
  /// among live connections of a channel: partial unique indexes in the migration.
  externalBusinessId String?
  externalPhoneId    String?

  listings  ChannelListing[]
  locations ChannelLocation[]
  platformListings PlatformListing[]
  metaEvents MetaEvent[]
  lanes      ConnectionLane[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, channel])
  @@index([channel, state])
}

/// One change Meta delivered by webhook, stored once by its dedupe key before anything acts on it
/// (ADR-0078, meta-foundation D3). The payload is sealed under the platform key ring and kept 30 days.
model MetaEvent {
  id                String            @id @default(cuid())
  /// `SOCIAL_PLATFORM`: instagram, whatsapp.
  product           String
  /// Meta's field, split by kind where one change carries several (`messages`, `messages.status`).
  field             String
  connectionId      String
  connection        ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalAccountId String
  dedupeKey         String            @unique
  /// Arrival order, so events in one second keep the order Meta sent them (WhatsApp times are whole seconds).
  seq               BigInt            @default(autoincrement())
  occurredAt        DateTime
  receivedAt        DateTime          @default(now())
  /// `META_EVENT_STATE`: PENDING, DONE, DEAD.
  state             String            @default("PENDING")
  /// Failures that say the event itself is bad; the fifth makes it dead.
  attempts          Int               @default(0)
  /// Failures of a sink that was down; they delay the event, never kill it.
  retries           Int               @default(0)
  lastErrorCode     String?
  sealedPayload     String
  processedAt       DateTime?

  // The drain's read is a partial index in the migration: (connectionId, occurredAt, id) WHERE PENDING.
  @@index([receivedAt])
}

/// One worker at a time per (connection, lane): serial per account, parallel across accounts
/// (social-selling TRD A-D9). Claimed and renewed by a conditional write; an expired lease is taken over.
model ConnectionLane {
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// `LANE`: events, messages, publish, catalogue, campaign.
  lane         String
  holder       String
  leaseUntil   DateTime

  @@id([connectionId, lane])
}

/// A person's request, through Meta, to delete what we hold about them (meta-foundation R7, D7). Names
/// nobody: the Meta user id is kept only as an HMAC and sealed for the job that acts on it.
model DataDeletionRequest {
  id           String    @id @default(cuid())
  /// The reference Meta shows the person; also the status page's address.
  code         String    @unique
  /// `SOCIAL_PLATFORM` whose app the request came through.
  product      String
  userIdHash   String
  sealedUserId String
  /// `DELETION_STATE`: PENDING, DONE.
  state        String    @default("PENDING")
  requestedAt  DateTime  @default(now())
  completedAt  DateTime?

  @@index([userIdHash])
}

/// Events dropped at the intake, counted per day and product, never stored (meta-foundation R2, R5, D12).
model MetaUnroutedCount {
  day            DateTime @db.Date
  product        String
  /// For an account no shop has connected.
  unrouted       Int      @default(0)
  /// Refused: the signature matched no secret.
  badSignature   Int      @default(0)
  /// Accepted under the secret being rotated out; zero for days means it can be removed.
  previousSecret Int      @default(0)

  @@id([day, product])
}

/// One listing a shop has on a marketplace, as the marketplace reported it (channel-import D1).
/// Read-only mirror plus one link to the shop's product. Never deleted: a listing gone from the
/// marketplace is marked so (Q12), and rows survive a disconnect (Q11).
model ChannelListing {
  id           String            @id @default(cuid())
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  orgId        String
  channel      String

  /// The marketplace's SKU exactly as it spells it, and trimmed lower-case for matching (Q3).
  sku        String
  skuKey     String
  /// ASIN or FSN.
  externalId String?
  title      String?
  imageUrl   String?
  /// `LISTING_STATUS`: LIVE, INACTIVE, INCOMPLETE.
  status     String?
  /// Paise, converted from what the marketplace reported (Invariant 3).
  pricePaise Int?
  quantity   Int?

  /// The variation parent this listing belongs to, when the marketplace says (Q9).
  parentSku     String?
  parentTitle   String?
  variationAxis String?

  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// `LINK_SOURCE`: SKU (by a read, or restored by Link back); OWNER is product-merge's manual link.
  linkSource    String?
  linkedAt      DateTime?
  /// Set when the owner unlinks; a read never links this row again on its own (Q5).
  unlinkedAt    DateTime?
  unlinkedById  String?
  /// The owner chose not to sell it on Bhendi Bazaar; a read never links it while set (product-merge Q9).
  leftOffAt     DateTime?
  leftOffById   String?
  /// Why it was left off: null for the owner's own choice, `no_type` when parked for want of a type (marketplace-facts Q6).
  leftOffReason String?

  /// The marketplace's last read of this listing's type, attributes and details (marketplace-facts D6).
  attributes       Json?
  attributesReadAt DateTime?
  /// When a fill was last queued for a listing never read (marketplace-facts Q36): queued once, and
  /// again only a week later if the read keeps failing, never every day.
  attributesTriedAt DateTime?
  /// Facts the owner chose to skip for now on this listing's card (marketplace-facts D6).
  attributeSkips   String[]  @default([])

  /// "Not one item" on a suggested group (family-merge Q21): the suggestion stays away.
  familyHintDismissedAt DateTime?

  /// The counts last sent to the marketplace, per its location id (inventory-sync D3): a send of the
  /// same counts is skipped, so a burst of changes costs one call.
  stockSent   Json?
  stockSentAt DateTime?

  /// The marketplace's photos being copied onto the linked product (product-merge D6).
  /// `PHOTO_COPY_MODE`: a new product gains them; a match replaces its gallery. Try again repeats it.
  photoMode      String?
  photoTotal     Int?
  photoDone      Int?
  photoFailed    Int?
  photoUpdatedAt DateTime?

  /// What the marketplace says stops or limits this listing, from the daily look (marketplace-publish Q23):
  /// its issues as ours, whether it is suppressed, and since when; all null once a look finds it clean.
  problems      Json?
  problemsSince DateTime?
  suppressed    Boolean   @default(false)

  /// The start of the last read that saw this listing; earlier than a finished read means gone (D8).
  lastSeenAt DateTime
  goneAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformListing PlatformListing?

  @@unique([connectionId, sku])
  @@index([orgId, channel])
  @@index([productId])
  @@index([orgId, skuKey])
}

/// A product's listing on one connected marketplace as the shop means it (channel-listings D1):
/// only the fields changed for that marketplace, and what was last sent. What the marketplace gets
/// is computed from the product with these laid over it; `ChannelListing` stays the mirror of what
/// the marketplace has. A family's own page (marketplace-publish D7) has `familyId` instead.
model PlatformListing {
  id           String            @id @default(cuid())
  orgId        String
  channel      String
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  productId String?
  product   Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  familyId  String?
  family    ProductFamily? @relation(fields: [familyId], references: [id], onDelete: Restrict)

  /// The mirror row once the listing exists on the marketplace; null for a draft.
  channelListingId String?         @unique
  channelListing   ChannelListing? @relation(fields: [channelListingId], references: [id], onDelete: SetNull)

  /// Only the fields changed for this marketplace, keyed by `LISTING_FIELD` (D2).
  overrides Json     @default("{}")
  /// The fields as last accepted by the marketplace (D3); null for a draft never sent.
  sent      Json?
  sentAt    DateTime?
  /// Compared and bumped by every save and publish (D4, marketplace-publish D3).
  version   Int      @default(0)

  /// `PUBLISH_STATE` (marketplace-publish Q4): what is in flight, never whether it is live.
  publishState  String    @default("idle")
  /// The fields and values of the publish in flight, as reviewed.
  pending       Json?
  publishedAt   DateTime?
  checkCount    Int       @default(0)
  nextCheckAt   DateTime?
  checkedAt     DateTime?
  /// The marketplace's complaints, each with our field or none (marketplace-publish D9).
  issues        Json?
  /// What the marketplace shows when it differs from what was sent: title, main photo (Q14).
  showing       Json?
  /// Whether the marketplace said it is on sale at the last check; null until known.
  live          Boolean?

  /// `CREATE_MODE` for a listing not yet on the marketplace: an offer on its page, or a new page.
  createMode       String?
  /// The page to sell on (ASIN) for an offer.
  targetExternalId String?
  /// The marketplace's product type for a new page.
  marketplaceType  String?
  /// The SKU it is created under, fixed at the draft.
  sku              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, productId])
  @@unique([connectionId, familyId])
  @@index([orgId, channel])
  @@index([publishState, nextCheckAt])
}

/// Which of a channel's categories a product type and kind list under
/// ([ADR-0045](../docs/adr/0045-channel-mappings-are-versioned-data.md), channel-registry D3).
///
/// Keyed by the pair because the platforms disagree about which of the two a distinction is:
/// Flipkart holds abaya, burqa and niqab as one node separated by a field, Meesho as three
/// categories. A rida maps through the same pair, and has an exact match on neither.
model ChannelCategoryMap {
  id          String  @id @default(cuid())
  channel     String
  /// A `ProductType.key`; `kind` is one of that type's declared kinds, or null for all of them.
  productType String
  kind        String?

  /// What the channel calls it — its node id, path, or whatever that channel keys on. Null only
  /// when `notSold` says this type is deliberately not published here, which has no category.
  theirCategory String?
  /// The owner has decided this type does not sell on this channel. A decision, not a blank: an
  /// absent row means nobody has chosen yet, and the register must tell the two apart or it keeps
  /// listing a settled question as work. Reversible — clearing it puts the choice back.
  notSold       Boolean @default(false)
  /// The one row of this type and kind that publishes here. Others are read when filling a
  /// product from a listing, never published to (marketplace-facts Q18).
  publishes     Boolean @default(true)
  /// How the channel labels it, so a screen can show something a person recognises.
  theirLabel    String?

  /// Whether this is the channel's own word for the same thing, or the closest it has (D6).
  /// A nearest fit is a **warning on every product**, not an approval taken once — otherwise it
  /// applies silently to later products it suits far less.
  fit  ChannelMapFit @default(EXACT)
  /// Why, when it is a nearest fit. Shown wherever the fit is.
  note String?

  /// When this was last checked, and against what. A claim about somebody else's system on a
  /// particular day; undated, it cannot be audited or expired (D4).
  checkedOn     DateTime
  checkedSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Several rows per type and kind may be read when filling (marketplace-facts Q18); one of them
  // publishes. Both rules are partial and expression indexes in the migrations, which Prisma's
  // schema language cannot declare; `tests/integration/channel-registry.test.ts` keeps them honest.
  @@index([channel])
}

enum ChannelMapFit {
  EXACT
  NEAREST
}

/// What a channel calls one of our facts, within one of its categories.
model ChannelAttributeMap {
  id            String @id @default(cuid())
  channel       String
  /// **Their** category, matching `ChannelCategoryMap.theirCategory` — not our product type.
  /// A required-field set belongs to the channel's own node: Flipkart's `bag` asks Number of
  /// Compartments and Waterproof, while `sling-bag` has neither field, and both are our `bag`.
  /// Keyed by our type, a sling bag would be told to answer a question Flipkart never asks.
  theirCategory String
  /// A `FACT` key from `server/catalog/listing-facts.ts`.
  fact          String

  theirAttribute String
  /// Whether that channel refuses a listing without it. An absent required one reads incomplete,
  /// the rest warn (D7). Nothing refuses a publish either way (D10).
  required       Boolean @default(false)
  /// The channel takes any text here rather than a value from a list of its own, so there is
  /// nothing to map and an answer it has never heard of is still a valid answer. Google's colour,
  /// material and pattern are free text; Flipkart's are closed lists. Without this the gate would
  /// report every colour as having no equivalent on a channel that needs no equivalent.
  freeText       Boolean @default(false)

  checkedOn     DateTime
  checkedSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, theirCategory, fact])
  @@index([channel, theirCategory])
}

/// A channel's own product type: what it accepts, read from the channel itself, never typed by hand
/// (listing-model/channel-catalogue D1, Q11). Written only by `channel-catalogue.repository`.
model ChannelType {
  id      String  @id @default(cuid())
  /// A `CHANNEL` key.
  channel String
  /// The channel's own name for it: Amazon `TOTE_BAG`, Flipkart `bag`, a Google category id.
  key     String
  label   String
  /// The channel's JSON Schema for the type, where it publishes one (Amazon); validated against before a send.
  schema        Json?
  schemaVersion String?
  /// Where it was read from: `amazon-definitions-api`, `flipkart-template`, `google-spec`…
  source  String
  readAt  DateTime
  /// The channel stopped offering it; kept so history and maps survive.
  goneAt  DateTime?

  fields  ChannelField[]
  changes ChannelTypeChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, key])
}

/// A required field a channel added to a type we already held: what Home tells the shops selling it
/// (listing-model Q22, channel-catalogue D6). Written only by `channel-catalogue.repository`.
model ChannelTypeChange {
  id            String      @id @default(cuid())
  channelTypeId String
  channelType   ChannelType @relation(fields: [channelTypeId], references: [id], onDelete: Cascade)
  /// The fields' keys and labels as the channel words them.
  added         Json
  detectedAt    DateTime    @default(now())

  @@index([detectedAt])
}

/// One field a channel type asks, as the channel defines it (channel-catalogue D1, Q4).
model ChannelField {
  id            String      @id @default(cuid())
  channelTypeId String
  channelType   ChannelType @relation(fields: [channelTypeId], references: [id], onDelete: Cascade)
  /// The channel's own name: `strap_type`, `outer.material`, `Bag Capacity`, `g:color`.
  key           String
  label         String
  /// One of FIELD_REQUIREMENT: required, conditional, optional.
  requirement   String
  /// One of FIELD_KIND: choice, text, number, measure, boolean.
  kind          String
  /// The values it accepts, as it words them; null when free.
  allowedValues Json?
  /// The units it accepts for a measure; null otherwise.
  allowedUnits  Json?
  /// Filled by the channel's adapter (identity, offer, compliance plumbing): never asked of the shop (Q5).
  adapterFills  Boolean   @default(false)
  readAt        DateTime
  goneAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelTypeId, key])
}

/// An attribute a channel's type requires that no fact answers: filled from the product itself or
/// with one fixed value for that type (setup-requests D6, Q32). Written only by `channel-map.repository`.
model ChannelAttributeFill {
  id             String  @id @default(cuid())
  channel        String
  /// Their category, as on `ChannelAttributeMap`.
  theirCategory  String
  theirAttribute String
  /// One of ATTRIBUTE_SOURCE (`server/listing/channel-map.types.ts`): sku, name or brand; null when `constant` is set.
  source         String?
  /// The fixed value sent for every product of this type; null when `source` is set.
  constant       String?

  checkedOn     DateTime
  checkedSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, theirCategory, theirAttribute])
}

/// One ticket per fix, however many shops need it (setup-requests D2, D3, Q9). Keyed by what fixes
/// it, never by who hit it. Written only by `server/requests/ticket.repository.ts`.
model Ticket {
  id      String @id @default(cuid())
  /// One of TICKET_TYPE: requirement (the admin enables it) or issue (a developer fixes it) (Q21).
  type    String
  /// One of TICKET_KIND: which plug-in plans, applies and checks it (D4).
  kind    String
  /// The fingerprint: `{kind}:{channel}:{subject}`. Two shops at once raise one ticket (D3).
  key     String @unique
  /// One of TICKET_STATUS: open, done, closed.
  status  String
  /// The kind's own small description of what fixes it (channel, their type, fields). Never a shop's.
  subject Json
  /// Why it closed: not_now or not_needed; null otherwise (Q11, Q13).
  closedReason String?

  openedAt   DateTime  @default(now())
  resolvedAt DateTime?
  /// Set when the same error came back after it was done (Q12).
  reopenedAt DateTime?
  updatedAt  DateTime  @updatedAt

  needs TicketNeed[]

  @@index([status, type])
}

/// One shop's need for a ticket: the incident to its problem (Q9). The admin's view counts these and
/// never reads them for a requirement (Q3); an issue's view reads them (Q22).
model TicketNeed {
  id        String  @id @default(cuid())
  ticketId  String
  ticket    Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The product that hit it; "" when none (a report from scratch), so the unique rule holds.
  productId String  @default("")
  /// The marketplace's complaint as received: code, attribute, message. Never shown to the admin on a requirement.
  detail    Json?
  /// An issue's category (ISSUE_CATEGORY) and the shop's own words (Q23, Q27).
  category  String?
  words     String? @db.Text

  raisedAt   DateTime  @default(now())
  /// When the shop was told it is resolved; the bell reads it later (D12).
  notifiedAt DateTime?

  @@unique([ticketId, orgId, productId])
  @@index([orgId])
}

/// What a channel calls one of our answers.
///
/// The layer nobody can automate: Google and Meta are the closest pair in this space and still
/// disagree — `in_stock` against `in stock`, five age groups against seven. An answer with no row
/// here fails readiness and the shop is asked to choose, once, for every product using it.
model ChannelValueMap {
  id       String @id @default(cuid())
  channel  String
  /// A `LIST` key, and the stored key of one of its values.
  list     String
  valueKey String

  theirValue String

  checkedOn     DateTime
  checkedSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, list, valueKey])
  @@index([channel, list])
}

/// A pickup location a marketplace knows for one connected account, and the shop's own location it
/// stands for (inventory-sync D1, Q15). Read on connecting and on Read again; matched once by the
/// owner and changed only by the owner. A location the marketplace stops reporting is marked gone,
/// never deleted.
model ChannelLocation {
  id           String            @id @default(cuid())
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  orgId        String

  /// The marketplace's own id; Amazon without multi-location is one location of ours to name.
  externalId String
  name       String
  pincode    String?

  orgAddressId String?
  orgAddress   OrgAddress? @relation(fields: [orgAddressId], references: [id], onDelete: SetNull)
  /// "Not used": nothing of ours stands behind it, so it is sent 0 (Q16).
  notUsed      Boolean     @default(false)
  matchedAt    DateTime?

  firstSeenAt DateTime
  lastSeenAt  DateTime
  goneAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([orgId])
  @@index([orgAddressId])
}

/// One line of an order placed on a marketplace, recorded once however often it is reported
/// (inventory-sync D4, ADR-0044): the stock it took here, whether it was oversold, and its restock
/// when cancelled before dispatch. Amounts as the marketplace reported them; never in payouts.
model MarketplaceOrder {
  id           String @id @default(cuid())
  connectionId String
  orgId        String
  channel      String

  orderId String
  lineId  String
  sku     String

  listingId          String?
  productId          String?
  /// The marketplace location it ships from, and the shop's location it was taken from.
  locationExternalId String?
  orgAddressId       String?
  /// The shop's location was not certain (an unmatched marketplace location): flagged for the owner (Q18).
  locationGuessed    Boolean @default(false)
  /// Sold before stock sync was on: recorded, stock not taken (inventory-sync Q24).
  beforeSync         Boolean @default(false)

  quantity    Int
  /// What was taken from our stock; less than `quantity` is an oversell (Q7).
  taken       Int       @default(0)
  oversold    Boolean   @default(false)
  amountPaise Int?
  state       String
  restockedAt DateTime?

  orderedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, orderId, lineId])
  @@index([orgId, orderedAt])
  @@index([productId])
}

/// A count the daily check found different on a marketplace and put back to ours (inventory-sync D5,
/// Q9): shown on the stock sync section; a record, never a decision.
model StockCorrection {
  id           String   @id @default(cuid())
  connectionId String
  orgId        String
  listingId    String
  title        String
  theirs       Int
  ours         Int
  correctedAt  DateTime @default(now())

  @@index([connectionId, correctedAt])
}

/// Where one channel field's value comes from (listing-model/field-maps D1, Q7). Keyed by the channel's
/// own names so a default ships before the channel is read; `bbType` blank means every type of ours
/// that publishes there, and a type's own row wins.
model FieldMap {
  id            String          @id @default(cuid())
  channel       String
  channelType   String
  /// The channel field, or a path into it (`outer.material`); the first segment is the field (Q8).
  fieldPath     String
  bbType        String          @default("")
  /// attribute / rule / core / shop / constant / developer (FIELD_SOURCE).
  source        String
  attributeKey  String?
  ruleKey       String?
  coreKey       String?
  shopKey       String?
  constant      String?
  /// The channel's unit word the value is converted to (`kilograms`).
  unitTarget    String?
  checkedSource String
  checkedOn     DateTime
  reason        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  values        FieldValueMap[]

  @@unique([channel, channelType, fieldPath, bbType])
}

/// One of our answers in a channel's word, for one map (field-maps D1, Q10).
model FieldValueMap {
  id           String   @id @default(cuid())
  fieldMapId   String
  fieldMap     FieldMap @relation(fields: [fieldMapId], references: [id], onDelete: Cascade)
  optionKey    String
  channelValue String
  createdAt    DateTime @default(now())

  @@unique([fieldMapId, optionKey])
}

/// One question a product can answer (listing-model/attributes D1, R1). Rows come only from migrations.
model Attribute {
  key        String    @id
  label      String
  /// choice / text / number / boolean / measure / reference (ATTRIBUTE_KIND).
  kind       String
  /// weight / length / volume, for a measure: the family its canonical unit belongs to (D4).
  unitFamily String?
  multi      Boolean   @default(false)
  /// product / brand / shop (ATTRIBUTE_SCOPE): who fills it by default (Q6).
  scope      String    @default("product")
  retiredAt  DateTime?
  createdAt  DateTime  @default(now())

  options AttributeOption[]
}

/// One answer an attribute's list allows (attributes D1, Q10): a platform answer, or a shop's own.
model AttributeOption {
  id           String    @id @default(cuid())
  attributeKey String
  attribute    Attribute @relation(fields: [attributeKey], references: [key], onDelete: Cascade)
  key          String
  label        String
  order        Int       @default(0)
  orgId        String?
  productTypes String[]  @default([])
  retiredAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([attributeKey, key, orgId])
  @@index([attributeKey])
}

/// Which attributes one of our types asks, in what order and under which label (attributes D2).
model BbTypeAttribute {
  id             String  @id @default(cuid())
  productTypeKey String
  attributeKey   String
  group          String?
  order          Int     @default(0)
  labelOverride  String?
  requiredForBb  Boolean @default(false)
  /// Derived from the type's own facts and measures by its trigger (Q12); false: added by migration (D8).
  fromType       Boolean @default(true)

  @@unique([productTypeKey, attributeKey])
}

/// A product's answer to one attribute, typed, with where it came from (attributes D3, R2). Kept in step
/// by a trigger until dynamic-form switches the writes (Q7); one value column set, enforced by a CHECK.
model ProductValue {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeKey String
  optionKey    String?
  text         String?
  number       Decimal?
  /// For a measure: the unit the shop typed; `number` is canonical (grams, millimetres, millilitres, D4).
  unit         String?
  bool         Boolean?
  refId        String?
  /// product / family / brand / shop / marketplace (VALUE_SOURCE).
  source       String
  sourceId     String?
  /// The answer exactly as the product holds it (`{ value, origin, unlisted?, source? }`): what every reader
  /// reads, so the switch from Product.facts loses nothing (dynamic-form Q16); the typed columns derive from it.
  answer       Json?
  /// A measurement (Product.measurements' half) rather than a fact; one key may in principle be both.
  measured     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([productId, attributeKey, measured])
  @@index([attributeKey, optionKey])
}

/// A product's values as one read (attributes Q8): `{ key: { v, unit?, src } }`, written with the rows.
model ProductValueSet {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    Json
  updatedAt DateTime @updatedAt
}

/// Who makes, packs or imports a brand's goods (listing-model/attributes D6, R4): what the brand fills into
/// its products' manufacturer, packer and importer. Every part optional but the role (parent Q29).
model BrandParty {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// maker / packer / importer (BRAND_PARTY_ROLE).
  role      String
  name      String?
  address   String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, role])
}

/// How complete one product is for one channel the shop sells on (listing-model/dynamic-form D3, R4):
/// stored by the refresh job, never computed on a page view. One writer.
model ProductChannelState {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The product's shop, kept here so listing counts without reading catalog's table (review).
  orgId       String
  channel     String
  /// Fields the channel requires that the shop answers (adapter fields excluded).
  required    Int
  missing     Int
  /// The channel's labels for what is missing, in its own words.
  missingKeys Json
  computedAt  DateTime @default(now())

  @@unique([productId, channel])
  @@index([orgId, channel])
}

/// A product's facts and measurements as they stood before answers moved to ProductValue (listing-model
/// retire-old-paths R3, dynamic-form Q16), kept so dropping the columns loses nothing. Read by no code; written
/// once by the migration that dropped them.
model ProductAnswersArchive {
  productId    String   @id
  facts        Json?
  measurements Json?
  archivedAt   DateTime @default(now())
}
