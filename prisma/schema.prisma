// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  // Join strategy for relation reads: one LATERAL JOIN instead of one query per
  // relation table. On per-operation billing that difference is the bill (CHANGELOG
  // PR-70/71). Applied per-query via relationLoadStrategy, not globally.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// One row per worker environment, upserted by the worker on a fixed cadence so admin can
/// say when it was last seen rather than guess (worker-foundation R5). Counts are copied from
/// the queue at the same moment; they are a snapshot, not a source of truth.
model WorkerHeartbeat {
  environment  String   @id
  version      String
  lastSeenAt   DateTime
  waiting      Int
  active       Int
  failed       Int
  /// Jobs finished in the 24 hours before the beat — the figure that says the worker is doing work, not just alive.
  completedDay Int      @default(0)
}

/// Every image the platform stores, as a record (media-library R1): what it is, how big, who
/// owns it, where it came from, and what it was made from. `ref` follows `ProductMedia.ref` —
/// a public URL for an image, a bare video id for an embed — so the two agree by construction.
/// A derived image records its source and its transform and never alters the source (R3).
/// Retired, never deleted, while anything references it (R7): every reference is `Restrict`.
model MediaAsset {
  id        String         @id @default(cuid())
  kind      MediaAssetKind
  ref       String
  /// Our object's pathname when the image lives in our store; null for an external URL or an embed.
  objectKey String?        @unique

  width       Int?
  height      Int?
  bytes       Int?
  mimeType    String?
  /// Playing time of a hosted video; null for anything else (video-hosting D1).
  durationMs  Int?
  /// SHA-256 of the stored bytes, hex. Within an org the same bytes are one asset, so a repeat
  /// upload is answered with the existing record rather than a second copy (media-library D11).
  contentHash String?

  /// Null means platform-owned: category heroes, home banners.
  orgId      String?
  org        Org?    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  source        MediaAssetSource
  derivedFromId String?
  derivedFrom   MediaAsset?      @relation("Derivation", fields: [derivedFromId], references: [id], onDelete: Restrict)
  derivatives   MediaAsset[]     @relation("Derivation")
  /// How a derived asset was made from its source — a crop rectangle, a surface key, an operation.
  transform     Json?
  /// The photograph an org member chose to stand in for this video instead of the derived frame (video-hosting spec R8).
  posterAssetId String?
  posterAsset   MediaAsset?      @relation("VideoPoster", fields: [posterAssetId], references: [id], onDelete: SetNull)
  postersFor    MediaAsset[]     @relation("VideoPoster")

  /// PENDING between the presign and the confirm; READY once the store has the bytes and the
  /// record has the dimensions; RETIRED when nothing should use it any more (trd D2, D8).
  state         MediaAssetState @default(PENDING)
  retiredAt     DateTime?
  /// Why a video could not be made playable, shown to the org member (video-hosting spec R7).
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productMedia     ProductMedia[]
  categoryHeroes   Category[]     @relation("CategoryHero")
  profileLogos     OrgProfile[]   @relation("ProfileLogo")
  profileHeroes    OrgProfile[]   @relation("ProfileHero")
  orgBanners       OrgBanner[]    @relation("OrgBannerImage")
  banners          Banner[]       @relation("BannerImage")
  /// The enhancements asked of this photograph, and the one this photograph was accepted from (image-enhancement trd D1).
  enhancementsFrom Enhancement[]  @relation("EnhancementSource")
  enhancementOf    Enhancement[]  @relation("EnhancementResult")

  @@index([orgId, state])
  @@index([orgId, contentHash])
  @@index([ref])
  @@index([derivedFromId])
  @@index([posterAssetId])
}

enum MediaAssetKind {
  IMAGE
  VIDEO_EMBED
  /// A video file we host: the upload is the source, its renditions and poster are DERIVED from it (video-hosting D1).
  VIDEO
}

enum MediaAssetSource {
  UPLOAD
  DERIVED
  EMBED
}

enum MediaAssetState {
  PENDING
  /// A confirmed video the worker is still making playable (video-hosting D1).
  PROCESSING
  READY
  /// A video no decoder read or that broke a limit; `failureReason` says which (spec R7).
  FAILED
  RETIRED
}

/// One requested improvement of one photograph (image-enhancement trd D1): the ledger row the
/// worker acts on and the quota counts. The proposal is an object under `proposals/`, never an
/// asset, until it is accepted — then `resultAssetId` names the DERIVED image made from it. Cost is
/// integer paise (Invariant 3), recorded per run (spec R9). Money-bearing, so nothing cascades.
model Enhancement {
  id            String           @id @default(cuid())
  orgId         String
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  requesterId   String?
  requester     User?            @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  sourceAssetId String
  sourceAsset   MediaAsset       @relation("EnhancementSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  tool          EnhancementTool
  /// A scene's setting, or any tool's named variant; null for a tool with none.
  preset        String?
  /// Which service performed the run — the platform's choice, recorded so a bake-off can be read back (spec R8).
  provider      String
  state         EnhancementState @default(REQUESTED)
  /// The gallery slot the request came from, for the record; the label slot is refused before a row exists (spec R5).
  slot          String?
  /// Where the proposal sits in the store while nobody has decided on it (trd D1).
  proposalKey   String?
  resultAssetId String?
  resultAsset   MediaAsset?      @relation("EnhancementResult", fields: [resultAssetId], references: [id], onDelete: SetNull)
  costPaise     Int              @default(0)
  /// Why a run failed, in the org member's words (spec R10).
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  proposedAt    DateTime?
  decidedAt     DateTime?

  @@index([orgId, createdAt])
  @@index([orgId, state])
  @@index([sourceAssetId])
}

/// How much enhancement one org may do, and whether it may do any (image-enhancement trd D5):
/// the allowance is a number, the pause a timestamp with its reason. Absent for an org means the
/// defaults declared in `server/content/enhancement.types.ts`; use itself is a count of rows, never stored.
model OrgEnhancementPolicy {
  orgId            String    @id
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  monthlyAllowance Int
  pausedAt         DateTime?
  pauseReason      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum EnhancementTool {
  CUTOUT
  WHITE
  STUDIO
  SCENE
  LIGHT
  ENLARGE
}

enum EnhancementState {
  REQUESTED
  RUNNING
  PROPOSED
  ACCEPTED
  DISCARDED
  FAILED
}

model Category {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  /// Self-referencing tree (category-tree D1/D2): null = root. Restrict, so a parent
  /// with children cannot be deleted; cycles are refused on the write path.
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryTree")
  description String         @db.Text
  heroImage   String // URL to hero image
  heroAssetId String?
  heroAsset   MediaAsset?    @relation("CategoryHero", fields: [heroAssetId], references: [id], onDelete: Restrict)
  accent      CategoryAccent @default(EMERALD)
  /// The named photo slots products in this category fill, inherited down the tree from the
  /// nearest ancestor that sets one; null means the platform's generic list (media-library D4).
  shotList    Json?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]

  promotionTargets PromotionTarget[]
  commissionRules  OrgCommissionRule[]

  @@index([slug])
  @@index([order])
  @@index([parentId])
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @db.Text
  price       Int // paise (Invariant 3). A reduction is an offer, never a column
  // on the product — see Promotion (ADR-0018 decision 4, promotions D9).
  currency    String @default("INR")

  categoryId String
  // Restrict, not Cascade: deleting a category must never delete its products
  // (category-tree D3 — the cascade only ever had an application-level count in its way).
  // Now the general rule rather than a local judgement (ADR-0020).
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags  String[] // Array of tags
  flags String[] @default([])
  // `images String[]` was here until product-video; a gallery is `media` now.

  /// Cache of the cover row's `ref` (product-video D4a/D4b), so every listing, search
  /// result, cart line and order line reads one table. Written only by the resolver,
  /// never from input; NOT NULL is the one database-level guarantee that a product has
  /// a picture at all.
  thumbnail String
  sizes     String[] // Available sizes
  colors    String[] // Available colors

  sku               String? // Stock Keeping Unit — unique within the org, not the platform
  lowStockThreshold Int     @default(10) // Alert when stock falls below this

  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  stockLocations   ProductStock[]
  media            ProductMedia[]
  promotionTargets PromotionTarget[]
  biddingEvents    BiddingEvent[]

  // ⭐ Org Association (REQUIRED)
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  // ⭐ ADD THIS:
  weight Float? @default(0.5) // Weight in kg

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  /// When the org took this product off sale ([ADR-0029](../docs/adr/0029-a-product-leaves-sale-by-archiving-not-deletion.md)).
  /// Null means on sale. Nothing else changes: the row, its media, its reviews and
  /// every order it appears on are untouched, and a restore clears this column.
  ///
  /// A timestamp rather than a status enum because there is no third lifecycle state
  /// to model, and "since when" is worth having for free. It is server-owned and
  /// never accepted from a request body (Invariant 4).
  archivedAt DateTime?

  // A SKU is the org's own identifier; two orgs may legitimately use the same one.
  // It stays taken while the product is archived — a restore must find its own code
  // still free, so uniqueness cannot be conditional on `archivedAt`.
  @@unique([orgId, sku])
  @@index([slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([orgId])
  // The org portal's default list is "this org, on sale", and it is the one query
  // this column adds to a hot path.
  @@index([orgId, archivedAt])
}

/// One item in a product's gallery — a photograph or an embedded video, in an order
/// the seller composes ([ADR-0017](../docs/adr/0017-video-is-embedded-not-hosted.md),
/// docs/specs/product-video/).
///
/// `position` orders the gallery and means nothing outside it (R16). The cover is the
/// row flagged `isThumbnail`, never the row at position 0, which is what lets a video
/// lead the gallery. Two constraints the schema language cannot express are added as
/// raw SQL in the migration: a partial unique index making at most one cover per
/// product a database fact, and a check that a cover is always an IMAGE.
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind MediaKind
  /// A stored URL for IMAGE and VIDEO, a bare video id for YOUTUBE — never a provider URL, so
  /// the host stays swappable by backfill rather than by migration (ADR-0017 decision 2).
  ref  String

  /// The library record behind an IMAGE row, linked by `ref` on write and by the backfill.
  /// Nullable through the transition; a video reference has none (media-library trd D1).
  assetId String?
  asset   MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)

  position    Int
  /// Which of the category's named slots this item fills; null for an extra beyond the slots or
  /// a video (media-library R4, D4). `position` still orders the gallery.
  slot        String?
  /// Per-item alt text. Nullable because the backfill has none to give: pre-existing
  /// galleries only ever had positional alt text generated at render.
  description String?

  isThumbnail Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId])
}

enum MediaKind {
  IMAGE
  YOUTUBE
  /// A video we host (video-hosting D1); `ref` is the source asset's URL.
  VIDEO
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Required, and Restrict: a review is attribution, so it never loses its author
  /// and its author can never be deleted out from under it (ADR-0032, ADR-0020).
  /// Was nullable with SetNull until PR-125, which cost three branches of defensive
  /// code for a state the platform does not allow.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  rating  Int // 1-5
  title   String?
  comment String? @db.Text

  /// Frozen at write time, never joined from `user` (product-reviews R11): a review is
  /// what someone said at a moment, so renaming an account must not rewrite it.
  userName   String
  isVerified Boolean @default(false) // Verified purchase, awarded from order history (R4)

  /// The platform took it down (R15). Null is published; restoring sets it back to null,
  /// the same shape `Product.archivedAt` uses. Replaced `isApproved`, which said
  /// "approved" about a review nothing ever approves.
  withdrawnAt DateTime?

  /// The author retracted it (R9). A separate act from withdrawal, by a different
  /// person, with a different remedy — one boolean could not tell them apart (ADR-0032).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media ReviewMedia[]

  /// Serves both the product page's newest-first list and the rating projection
  /// (product-reviews trd.md D4): one product, visible only, newest first. Both
  /// state columns are in it because `VISIBLE_REVIEW_WHERE` tests both together.
  @@index([productId, withdrawnAt, deletedAt, createdAt])
  @@index([userId])
  @@index([createdAt])
}

/// A photograph the buyer took, or a video they had already published elsewhere
/// (review-media R1, R5).
///
/// Its own table rather than a `reviewId` on `ProductMedia`: every gallery, cover and
/// thumbnail query reads that one, so a review's picture living there would be one
/// forgotten `where` away from becoming the product's own (review-media trd.md D1).
///
/// Cascade is correct here — a review's media carries no money and no attribution, which
/// is the case ADR-0020 leaves cascading, and R12 wants the rows gone with the review.
/// The objects in R2 are deleted by the service, since a cascade cannot reach them.
model ReviewMedia {
  id       String    @id @default(cuid())
  reviewId String
  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kind     MediaKind
  /// An object URL in our own bucket for IMAGE, a bare video id for YOUTUBE — never a
  /// provider URL (ADR-0017 decision 2).
  ref      String
  /// Array index. A list has an order; nothing outside the review reads it.
  position Int       @default(0)

  @@index([reviewId])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The pre-PR-44 blob, kept one release as the audit copy of the lift. Read by
  // nothing; lines live in CartItem rows (order-and-cart-lines trd.md).
  legacyItems Json?      @map("items")
  items       CartItem[]
  version     Int        @default(1) // For optimistic locking
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Cascade, unlike OrderItem: a cart line is a wish, not history — deleting the
  // product just removes it from carts.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int
  size     String?
  color    String?

  @@index([cartId])
  @@index([productId])
}

/// A user's saved products. One per user, created on the first heart rather than at
/// signup — a wishlist nobody has opened should not exist. No `wlId` on `User`: the
/// unique `userId` here is the whole relationship, and a second copy on the other side
/// is a column that can disagree with this one.
model Wishlist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One saved product. Rows rather than a `productIds String[]` on the parent, for the
/// reason PR-41/43/44 lifted their blobs: an array cannot carry a foreign key, so a
/// deleted product leaves an id nothing resolves, and every add is a read-modify-write
/// of the whole array that a second device silently overwrites.
model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  // Cascade, like CartItem and unlike OrderItem: a saved product is a wish, not
  // history, so deleting the product just removes it from wishlists. ADR-0020 governs
  // rows carrying money or attribution; this one carries neither.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Hearting twice is the same wish: the second click is a no-op, not a duplicate row.
  // Also the index for "is this product saved", so no separate wishlistId index.
  @@unique([wishlistId, productId])
  @@index([productId])
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  emailVerified   DateTime? // Keep this for NextAuth compatibility
  isEmailVerified Boolean      @default(false) // Our custom field
  /// Contact data, not an identity key: one number may back any number of accounts (ADR-0024).
  mobile          String?
  passwordHash    String?
  platformRole    PlatformRole @default(USER)
  /// The platform shut them out. Punitive, admin-reversible, and not the same thing as
  /// `deactivatedAt` below — a banned account and a closed one need different answers.
  isBlocked       Boolean      @default(false)
  /// The account is retired. A user is never deleted (ADR-0032), so this is what
  /// "delete my account" does; rows that attribute to them keep pointing at them.
  deactivatedAt   DateTime?
  lastActiveAt    DateTime     @default(now())
  profile         Profile?
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  reviews         Review[]
  adminLogs       AdminLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accounts              Account[]
  sessions              Session[]
  orgMemberships        OrgMember[]
  mediaAssets           MediaAsset[]
  addresses             UserAddress[]
  enhancementsRequested Enhancement[]

  settlementsCreated Settlement[] @relation("SettlementCreatedBy")
  settlementsUpdated Settlement[] @relation("SettlementUpdatedBy")

  bids                 Bid[]          @relation("UserBids")
  biddingEventsCreated BiddingEvent[] @relation("BiddingCreatedBy")
  biddingEventsSettled BiddingEvent[] @relation("BiddingSettledBy")

  @@index([platformRole])
  @@index([isBlocked])
  @@index([lastActiveAt])
  @@index([isEmailVerified])
}

model Profile {
  id              String  @id @default(cuid())
  user            User    @relation(fields: [userId], references: [id])
  userId          String  @unique
  legacyAddresses Json?   @map("addresses") // pre-PR-41 blob, kept one release as backup; read by nothing
  profilePic      String? // URL to avatar image
}

model Org {
  id   String @id @default(cuid())
  code String @unique // "SEL-001", "SEL-002"

  /// The shop's public address: `/store/<handle>`. Generated from the name at creation
  /// and changeable by its owner thereafter; a retired one is held, then released
  /// (ADR-0030 decision 4). Never accepted on a general org update — only through the
  /// handle-change operation, which is why it is absent from CreateOrgInput.
  handle String @unique
  name   String // "ABC Traders", "XYZ Wholesale"

  // Contact Information
  email         String
  phone         String?
  contactPerson String? // "John Doe"

  // Business Details
  orgAddresses OrgAddress[]

  businessName String?
  gstNumber    String?
  panNumber    String?

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false) // KYC verification

  // Everything a buyer may see lives on the profile; everything else stays here
  // (org-profile spec R1/R2, trd D1). A leak now needs a join nobody wrote.
  profile           OrgProfile?
  listingDefaults   OrgListingDefaults?
  brands            Brand[]
  mediaAssets       MediaAsset[]
  enhancements      Enhancement[]
  enhancementPolicy OrgEnhancementPolicy?

  /// The platform's cut, in basis points — 1500 = 15%. Set per org by design; rates
  /// differ between orgs (org-payouts spec R12). Category overrides live in
  /// `OrgCommissionRule`, and the resolved rate is snapshotted onto every ledger
  /// line so a later change cannot rewrite a past settlement (payouts D4).
  commissionBps  Int @default(1500)
  /// How deep this org may discount its **own** goods. A guard against mis-keying a
  /// margin away with self-serve signup — not a platform protection, since an org's
  /// discount shrinks the platform's commission proportionally and can never drive it
  /// negative (promotions D13a).
  maxDiscountBps Int @default(5000)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products  Product[]
  shipments Shipment[]
  members   OrgMember[]

  storefrontBanners OrgBanner[]
  handleHistory     OrgHandleHistory[]

  promotions      Promotion[]
  orderDiscounts  OrderDiscount[]
  commissionRules OrgCommissionRule[]
  ledgerEntries   OrgLedgerEntry[]
  settlements     Settlement[]
  biddingEvents   BiddingEvent[]

  @@index([email])
  @@index([isActive])
  @@index([code])
  @@index([handle])
}

/// The public face of an organisation: what a storefront or an advertisement may show, and
/// nothing else (org-profile spec R1, trd D1). One row per org, created with it. The storefront
/// reads this table only, so a private column on `Org` cannot reach a buyer by accident.
model OrgProfile {
  orgId String @id
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// One line under the name. Not the introduction; a shelf label, not a paragraph.
  tagline        String?
  /// The storefront's introduction — the long-form "who we are". Plain text, rendered as
  /// text (ADR-0030 D9).
  description    String?     @db.Text
  logoUrl        String?
  /// The shop's cover image, shown at the top of its about page — not on the storefront
  /// itself, where the promotions hold that slot (decided 2026-09-19). Distinct from
  /// `OrgBanner`, a rotating promotion. Through the same object store and optimizer as every
  /// other image (ADR-0026, ADR-0028).
  heroUrl        String?
  logoAssetId    String?
  logoAsset      MediaAsset? @relation("ProfileLogo", fields: [logoAssetId], references: [id], onDelete: Restrict)
  heroAssetId    String?
  heroAsset      MediaAsset? @relation("ProfileHero", fields: [heroAssetId], references: [id], onDelete: Restrict)
  /// A token name from the palette in globals.css — never a colour literal (ADR-0022).
  accent         String?
  /// What this shop promises about delivery and returns. The platform's own terms stand in
  /// where these are null; payment and fraud are never the shop's to disclaim.
  deliveryPolicy String?     @db.Text
  returnsPolicy  String?     @db.Text

  /// The longer story, the location as the shop chooses to state it, and handles on known
  /// networks. All optional; nothing here is required to open a shop (org-profile spec R5).
  story    String? @db.Text
  location String?
  social   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The private listing context that does not belong to a brand (org-profile spec R4): what a
/// product inherits when neither it nor its family nor its brand says otherwise. Pre-fills,
/// never validates. The tax rate is basis points, never a float.
model OrgListingDefaults {
  orgId String @id
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  countryOfOrigin   String?
  taxRateBps        Int?
  /// Tax code per category id the org sells in.
  taxCodeByCategory Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A brand an organisation sells, with the facts that belong to the brand rather than the
/// shop: who makes it, who packs or imports it, where it comes from (org-profile spec R3). A
/// manufacturer has one; a shop carrying others' brands has many. Retired, never deleted (R9, ADR-0032).
model Brand {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name             String
  manufacturer     String?
  packerOrImporter String?
  countryOfOrigin  String?
  isDefault        Boolean @default(false)

  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id     String  @id @default(cuid())
  code   String  @unique // "BB-1001"
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Delivery address (same for all shipments)
  address Json // OrderAddress
  notes   String? @db.Text

  // ✅ NEW: Order-level totals
  itemsTotal    Int @default(0) // paise
  shippingTotal Int @default(0) // paise
  discount      Int @default(0) // paise
  grandTotal    Int @default(0) // paise: itemsTotal + shippingTotal - discount

  // Payment (single for entire order)
  paymentMethod  String? // "razorpay"
  paymentStatus  String? @default("pending") // pending, paid, failed
  paymentId      String? // the CONFIRMED gateway payment id — the idempotency key (payment-confirmation D2)
  gatewayOrderId String? // the gateway order this order was charged through; created with amount = grandTotal

  // Overall order status. The values live in ORDER_STATUS
  // (server/checkout/order.types.ts) — "expired" means an abandoned checkout whose
  // reservation has been released, kept for follow-up and hidden from every panel.
  status String @default("processing")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ NEW: Relations to shipments
  items          OrderItem[]
  shipments      Shipment[]
  shippingEvents ShippingEvent[] // ← ADD THIS

  /// One row per offer that touched this order, carrying who funded it (ADR-0019).
  /// `discount` above is their sum — a display total, never an input to settlement.
  discounts     OrderDiscount[]
  ledgerEntries OrgLedgerEntry[]

  @@index([userId])
  @@index([code])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt]) // the reconciliation sweep asks "pending and old"
  @@index([gatewayOrderId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Restrict: a sold product cannot be deleted out from under its order history
  // (order-and-cart-lines R2).
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity  Int
  unitPrice Int // paise — the price as it stood at purchase, from birth (ADR-0004)
  /// The picture as it stood at purchase (product-video R17/D19). Same kind of fact as
  /// `unitPrice`: written server-side at order creation, never updated, never accepted
  /// from a request body. Stores the URL rather than a media id, because the media row
  /// is exactly what gets deleted in the case this exists for. Nullable only for rows
  /// that predate the column — the backfill fills what it can, which is today's cover,
  /// not what those buyers saw.
  thumbnail String?

  /// This line's share of the buyer's discount, allocated by largest-remainder
  /// rounding so per-line shares sum to the scope total exactly (ADR-0019).
  discountPaise  Int @default(0)
  /// How much of `discountPaise` the org bore; the platform bore the remainder.
  /// Persisted per line rather than only per offer because the ledger's commission
  /// base is `unitPrice * quantity - orgFundedPaise` **per line**, and rates resolve
  /// per line too (org-payouts D4c). Deriving it at settlement time would mean
  /// re-running the offer engine against a catalogue that has since moved.
  orgFundedPaise Int @default(0)

  // The chosen variant. Nullable: products without options have neither.
  size  String?
  color String?

  shipmentItems ShipmentItem[]
  ledgerLines   OrgLedgerEntryLine[]

  @@index([orderId])
  @@index([productId])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Cascade with the order line: the link is meaningless without it, and an
  // OrderItem only ever dies with its whole order.
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity Int

  @@index([shipmentId])
  @@index([orderItemId])
}

model Shipment {
  id   String @id @default(cuid())
  code String @unique // "BB-1001-SH1", "BB-1001-SH2"

  // Parent order
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The pre-PR-43 blob, kept one release as the audit copy of the lift. Read by
  // nothing; lines live in ShipmentItem rows (order-and-cart-lines trd.md).
  legacyItems Json?          @map("items")
  items       ShipmentItem[]

  // ✅ Origin details (where it ships from)
  orgId        String
  org          Org         @relation(fields: [orgId], references: [id])
  /// The pickup location this parcel was allocated from (stock-locations D5/D6).
  /// Nullable: pre-existing shipments keep NULL rather than a guessed attribution.
  /// The from* columns below stay as the historical snapshot — editing a location's
  /// address must never rewrite where a delivered parcel came from (A5).
  orgAddressId String?
  orgAddress   OrgAddress? @relation(fields: [orgAddressId], references: [id], onDelete: Restrict)
  fromPincode  String
  fromCity     String
  fromState    String

  // ✅ Shipping details (specific to this shipment)
  shippingCost       Int // paise
  shippingProviderId String?
  shippingProvider   ShippingProvider? @relation(fields: [shippingProviderId], references: [id])

  // ✅ Tracking (independent per shipment)
  trackingNumber String?
  courierName    String? // "BlueDart Surface"
  trackingUrl    String?

  // ✅ Status (independent per shipment)
  /// One of SHIPMENT_STATUS (server/shipping/domain/shipping.types.ts). Written only by
  /// shipment-status.service.ts, which the transition table guards.
  status            String    @default("packing")
  shipmentStatus    String? // Provider-specific status
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  /// When this parcel's units were returned to stock. The idempotency marker for restocking:
  /// a courier repeating a terminal event must not credit the same units twice
  /// (docs/specs/shipment-lifecycle/ D7).
  restockedAt       DateTime?

  // Package details
  packageWeight     Float?
  packageDimensions Json? // {length, width, height}

  // Metadata
  shippingMeta Json? // Provider-specific data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shippingEvents ShippingEvent[]

  @@index([orderId])
  @@index([orgId])
  @@index([status])
  @@index([trackingNumber])
}

model ShippingProvider {
  id          String  @id @default(cuid())
  code        String  @unique // 'shiprocket', 'delhivery', 'bluedart', etc.
  name        String // Display name: "Shiprocket", "Delhivery"
  description String? @db.Text // Provider description

  priority Int @default(0) // Higher number = higher priority

  // Authentication & Connection Status
  isConnected    Boolean   @default(false) // Is account connected?
  connectedAt    DateTime? // When was it connected?
  connectedBy    String? // Admin user ID who connected it
  connectionType String    @default("email_password") // [ 'email_password', 'api_key', 'oauth' ]
  lastAuthAt     DateTime? // Last successful authentication
  authError      String?   @db.Text // Last auth error message

  // Encrypted sensitive data
  authToken      String?   @db.Text // Encrypted JWT token
  tokenExpiresAt DateTime? // Token expiry timestamp

  // Account info (includes encrypted password)
  accountInfo Json? // {
  //   email: string,
  //   password: string (encrypted),
  //   firstName: string,
  //   lastName: string,
  //   companyId: number,
  //   warehousePincode?: string
  // }

  // Capabilities
  paymentOptions String[] // ['prepaid', 'cod']
  deliveryModes  String[] // ['air', 'surface']
  features       Json? // {tracking: true, label: true, scheduling: true}

  // Metadata
  logoUrl    String? // Provider logo
  websiteUrl String? // Provider website

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments Shipment[]
  rateCache ShippingRateCache[]
  events    ShippingEvent[]

  @@index([isConnected])
  @@index([code])
}

// Caches shipping rates to reduce API calls and improve performance
model ShippingRateCache {
  id String @id @default(cuid())

  // Provider reference
  providerId String
  provider   ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Rate calculation parameters
  fromPincode String
  toPincode   String
  weight      Float // in kg
  mode        String // 'prepaid', 'cod'

  // Cached rate information
  rate          Int // paise
  courierName   String // Courier service name
  estimatedDays Int // Estimated delivery days

  // Additional metadata
  metadata Json? // Any additional provider-specific data

  // Cache management
  expiresAt DateTime // When this cache entry expires
  createdAt DateTime @default(now())

  @@unique([providerId, fromPincode, toPincode, weight, mode])
  @@index([expiresAt])
  @@index([fromPincode])
  @@index([toPincode])
}

// Tracks all shipping-related events for debugging and analytics
model ShippingEvent {
  id String @id @default(cuid())

  // Order reference
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Shipment reference
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Provider reference
  providerId String
  provider   ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Event details
  eventType String // 'rate_check', 'shipment_created', 'status_update', 'cancellation'
  status    String // 'success', 'failed', 'pending'

  // Request/Response logging (for debugging)
  request  Json? // API request payload
  response Json? // API response

  // Error tracking
  errorMessage String? @db.Text
  errorCode    String?

  // Metadata
  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([shipmentId])
  @@index([providerId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

// Admin activity logging
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  // Restrict, not Cascade: deleting an admin must never erase the audit trail of
  // what they did — that is the record you want most when removing one. Block or
  // deactivate the account instead (User.isBlocked).
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String // e.g., "USER_BLOCKED", "PRODUCT_UPDATED"
  resource   String // e.g., "User", "Product", "Order"
  resourceId String // ID of the affected resource
  metadata   Json? // Additional details about the action
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([resource])
  @@index([action])
}

/// What a person may do inside one org. Declared here rather than as a TypeScript
/// union so there is exactly one declaration and the database rejects anything else —
/// unlike `ProductFlag`, which is a TS enum over a `String[]` because Postgres arrays
/// of enums are awkward. A role is scalar, so it does not need that compromise.
enum OrgRole {
  OWNER
  STAFF
}

/// A person's membership of an org. The relationship carries the role, because a role
/// on `User` could not express "owner of A, staff at B".
///
/// Cascade on both sides is deliberate: a membership is meaningless without either end,
/// and deleting one end must remove only the link — never the other party.
/// A selling organisation's pickup location (stock-locations D1/D10): the org's
/// relationship to a postal Address — courier nickname, who answers the door at
/// pickup, and the aggregator registration designed for but not built (D11).
/// Restrict both ways: an org with locations, or a location an Address underpins,
/// cannot be deleted out from under the other.
/// A handle this org used to hold.
///
/// Kept forever rather than deleted at expiry: the hold is *derived* by comparing
/// `retiredAt` against the window, so nothing has to run for the answer to be right
/// (ADR-0023's shape). While held the handle redirects here and no other org may take
/// it; past the window it stops doing both. Taking a handle back deletes its rows, or
/// the old address would redirect away from the shop now living at it (ADR-0030).
model OrgHandleHistory {
  id     String @id @default(cuid())
  handle String
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  retiredAt DateTime @default(now())

  /// Not unique on `handle` alone: an org may leave a handle, take it back, and leave
  /// it again, which is two rows for one string.
  @@index([handle, retiredAt])
  @@index([orgId])
}

/// A promotion an org runs across the top of its own storefront.
///
/// Rendered through the platform's own hero, so a shop's promotion and the platform's
/// look alike. Distinct from `Org.heroUrl`, which is the shop's static cover image.
///
/// Deliberately not `orgId` on `Banner`: that table is the platform's home page, and
/// "an org's promotion never reaches it" (storefront-branding R2d) is a rule worth
/// making structural rather than a where-clause every future query has to remember.
model OrgBanner {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Optional: a promotion can be the picture alone.
  title        String?
  description  String?
  /// Through the optimizer, like every other image (ADR-0026).
  imageUrl     String?
  imageAssetId String?
  imageAsset   MediaAsset? @relation("OrgBannerImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  imageAlt     String?

  /// Where it points — always inside this org's own storefront (R2c), enforced in the
  /// schema that parses it rather than by the column's type.
  href String?

  /// Server-owned: a create appends, only a reorder rewrites it.
  order    Int     @default(0)
  /// Taken down, not deleted, so a campaign can run again next season (R2b).
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, isActive, order])
}

model OrgAddress {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  name         String // courier pickup nickname — "Bhendi Bazaar shop", "Bhiwandi godown"
  contactName  String // '' until a human completes it; required if fulfilment books real pickups
  contactPhone String
  isActive     Boolean @default(true)
  /// Aggregator pickup-location reference (D11): carried, read by nothing yet.
  providerRef  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productStock ProductStock[]
  shipments    Shipment[]

  @@index([orgId])
}

/// Where a product's units physically sit (stock-locations D2): the quantity lives
/// on the join row, because a location without a quantity is a place the store
/// cannot honour a quote from. Restrict on the location side is R8 in the database.
model ProductStock {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orgAddressId String
  orgAddress   OrgAddress @relation(fields: [orgAddressId], references: [id], onDelete: Restrict)
  quantity     Int

  @@id([productId, orgAddressId])
  @@index([orgAddressId])
}

model OrgMember {
  id     String  @id @default(cuid())
  userId String
  orgId  String
  role   OrgRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Whether a person runs the platform. Distinct in kind from `OrgRole`: there is exactly
/// one platform, so this is a property of the person, whereas a role inside an org is a
/// property of a relationship. Kept an enum rather than a boolean because a read-only
/// support role is a plausible third value.
enum PlatformRole {
  USER
  ADMIN
}

/// A category's accent, stored as a semantic key and mapped to classes at render
/// (`src/lib/category-accent.ts`). Rows used to hold raw Tailwind class strings —
/// presentation frozen into the database, which broke the moment the classes moved.
enum CategoryAccent {
  EMERALD
  BLUE
  PURPLE
  PINK
  ORANGE
  YELLOW
  RED
  GRAY
}

/// A postal fact, identity-agnostic (addresses-as-entities D1/D2): who receives there
/// lives on the owning relationship (`UserAddress` now, `OrgAddress` when
/// stock-locations lands). No uniqueness on purpose — free text does not normalise,
/// and a shared row would force copy-on-write on every edit.
model Address {
  id           String  @id @default(cuid())
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  /// Provenance, not ownership — nullable so seeds and system rows are honest.
  createdBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAddresses UserAddress[]
  orgAddresses  OrgAddress[]

  @@index([pincode])
}

/// A person's relationship to an address: their label for it, and who receives there
/// (not necessarily the account holder). No `isDefault` by decision — the buyer picks
/// at checkout.
model UserAddress {
  id        String  @id @default(cuid())
  userId    String
  addressId String
  label     String?
  fullName  String
  phone     String
  email     String?
  notes     String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Promotions — offers the platform and its orgs can run
// (docs/specs/promotions/, ADR-0018, ADR-0019, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// Who funds an offer. Genuinely two-valued and staying so, which is why it is an
/// enum while *what an offer covers* is a table (promotions D2).
enum PromotionScope {
  PLATFORM
  ORG
}

/// How an offer activates. AUTOMATIC offers set the price shown on a product page,
/// so they may carry no basket-level condition; CODE offers are entered at checkout,
/// where the basket is known, and may (promotions D5).
enum PromotionTrigger {
  AUTOMATIC
  CODE
}

/// PERCENT and AMOUNT_OFF reduce; FIXED_PRICE sets an outright selling price, which
/// is what a per-product markdown means and what a percentage cannot express
/// (promotions D4/D9). FIXED_PRICE is only legal on a product-targeted offer.
enum PromotionValueType {
  PERCENT
  AMOUNT_OFF
  FIXED_PRICE
}

/// A time-boxed offer. Three independent axes: who funds it (`scope`), how it
/// activates (`trigger`), and what it covers (`targets` — zero rows means everything
/// in scope, promotions D3).
///
/// Constraints the schema language cannot express are added as raw SQL in the
/// migration: scope/orgId agreement, trigger/code agreement, a value matching its
/// type, and endsAt after startsAt.
model Promotion {
  id    String @id @default(cuid())
  /// Shown to the buyer on the line badge and frozen onto OrderDiscount at purchase.
  label String

  scope PromotionScope
  /// Set iff scope = ORG. Restrict: an org with campaign history is not deletable.
  orgId String?
  org   Org?           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  trigger PromotionTrigger
  /// Set iff trigger = CODE. Globally unique — a buyer types one string and it must
  /// resolve to exactly one offer. Org codes carry the org's own code as a prefix
  /// (promotions D13), which makes collisions impossible rather than merely reported.
  code    String?          @unique

  valueType       PromotionValueType
  /// Basis points — 2000 = 20%. Integer, so no float reaches the money path (ADR-0004).
  percentBps      Int?
  amountOffPaise  Int?
  fixedPricePaise Int?

  /// CODE offers only (promotions D5): a product page cannot know the basket.
  maxDiscountPaise Int?
  minSubtotalPaise Int  @default(0)

  /// Every offer is time-boxed — no offer runs indefinitely (spec R4).
  startsAt DateTime
  endsAt   DateTime
  /// The kill switch, independent of the window: a mispriced sale must die in one
  /// click, not a date edit (spec R5).
  isActive Boolean  @default(true)

  /// Enforced with a conditional update inside the order transaction (promotions D11,
  /// ADR-0007). Read-then-write oversells a coupon exactly as it oversells stock.
  usageLimit   Int?
  usageCount   Int  @default(0)
  perUserLimit Int?

  targets        PromotionTarget[]
  orderDiscounts OrderDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([scope, orgId])
  @@index([trigger])
}

/// What an offer covers. Exactly one dimension per row; zero rows on a promotion
/// means "everything in scope" (promotions D3), which is why these **restrict**
/// their category and product: a cascade would remove an offer's only target and
/// silently widen it store-wide (promotions D3a, ADR-0020).
///
/// Cascade on `promotionId` is composition, not reference — the same distinction
/// `OrderItem` already draws between its order and its product.
model PromotionTarget {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  /// A category target covers its whole subtree (promotions spec R2).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([promotionId, categoryId])
  @@unique([promotionId, productId])
  @@index([categoryId])
  @@index([productId])
}

/// One offer's effect on one order, with its cost divided between the two parties
/// who could have paid for it (ADR-0019). `orgFundedPaise + platformFundedPaise =
/// buyerDiscountPaise` is asserted by a CHECK in the migration, so no settlement can
/// be computed from a split that does not reconcile.
///
/// Restricts both its promotion and its order: this row is the attribution a payout
/// reads, and it must outlive any tidying of either (ADR-0020).
model OrderDiscount {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  /// Whose lines this concerns. Always set — a platform offer still lands on some
  /// org's goods, and the ledger needs to know whose.
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Frozen at purchase, so a renamed or reworded offer cannot rewrite a receipt —
  /// the same reasoning that froze `thumbnail` onto OrderItem.
  labelSnapshot String
  codeSnapshot  String?

  buyerDiscountPaise  Int
  orgFundedPaise      Int
  platformFundedPaise Int

  createdAt DateTime @default(now())

  @@unique([orderId, promotionId, orgId])
  @@index([promotionId])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payouts — what each org earned, what the platform kept, what is still owed
// (docs/specs/org-payouts/, ADR-0019, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// SALE is written from the paid transition; REVERSAL offsets one; ADJUSTMENT is a
/// manual line the order flow does not produce — a reimbursement, a penalty
/// (payouts D6, spec R5).
enum LedgerEntryKind {
  SALE
  REVERSAL
  ADJUSTMENT
}

/// What gates editing (payouts D6). DRAFT is editable; once its settlement is paid
/// the entry is SETTLED and its figures are fixed, because it now records a transfer
/// that actually happened.
enum LedgerEntryState {
  DRAFT
  SETTLED
  REVERSED
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED
}

/// An org's commission rate for a category, overriding its default. Nearest ancestor
/// wins, so a rate on a parent means "unless a child says otherwise" with no
/// precedence field to configure (payouts D4a/D4b).
///
/// Restricts its category: a cascade here would silently move an org onto a
/// different rate (ADR-0020).
model OrgCommissionRule {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  rateBps Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, categoryId])
  @@index([orgId])
  @@index([categoryId])
}

/// One org's share of one order, written when the order is paid — never when it is
/// placed, so an order that never pays never appears in a payout (payouts D5).
///
/// `commissionBase = grossItemsPaise - orgFundedDiscountPaise`: commission is charged
/// on what the org's goods earned after the org's own discount, and before any
/// discount the platform chose to fund. Basing it on what the buyer paid would
/// quietly make the org co-fund the platform's campaign (payouts D2).
///
/// No rate column: rates resolve per item, so one entry can carry several and the
/// rate lives on the line (payouts D4c).
model OrgLedgerEntry {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Null for a manual adjustment, which has no order behind it (spec R5).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  kind  LedgerEntryKind  @default(SALE)
  state LedgerEntryState @default(DRAFT)

  grossItemsPaise             Int
  orgFundedDiscountPaise      Int
  /// Informational: excluded from the base, shown as the platform's campaign cost
  /// against this order (payouts D2, spec R17).
  platformFundedDiscountPaise Int
  commissionBasePaise         Int
  commissionPaise             Int
  /// Signed, so a REVERSAL is the same shape with the opposite sign (payouts D6).
  payablePaise                Int

  /// Raised on write rather than found in a reconciliation (payouts D12). True when
  /// the platform funded more than it earned on this entry.
  isNegativeMargin Boolean   @default(false)
  /// A figure that no longer derives from its order should not look like one that
  /// does (payouts D9b).
  isManuallyEdited Boolean   @default(false)
  /// Soft delete: a hard one would drop money out of a balance leaving nothing to
  /// explain the change (payouts D9a).
  deletedAt        DateTime?

  note String?

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  lines OrgLedgerEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, orgId, kind])
  @@index([orgId, deletedAt])
  @@index([settlementId])
  @@index([isNegativeMargin])
}

/// One order line's contribution to an entry, carrying the rate that actually
/// applied to it (payouts D4c). Cascade on the entry is composition; Restrict on the
/// order line is a reference to another aggregate — the same split `OrderItem` draws
/// between its order and its product.
model OrgLedgerEntryLine {
  id      String         @id @default(cuid())
  entryId String
  entry   OrgLedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Null for a manual adjustment's line.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  basePaise       Int
  rateBps         Int
  commissionPaise Int

  @@index([entryId])
  @@index([orderItemId])
}

/// A batch of entries the platform has paid, or intends to. Free-form over whatever
/// is unsettled — no period and no schedule, because a transfer is decided when it
/// suits and a period column would only describe which entries happened to be picked
/// (payouts D7).
model Settlement {
  id    String @id @default(cuid())
  code  String @unique
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  amountPaise Int
  status      SettlementStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?
  note        String?

  /// Restrict, as `AdminLog` already does: removing a person must never erase the
  /// record of what they authorised.
  createdByUserId String
  createdBy       User    @relation("SettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String?
  updatedBy       User?   @relation("SettlementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  entries OrgLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([code])
}

/// The storefront's hero banners. Platform-owned shelf space: an org promoting its own
/// products is what offers are for.
model Banner {
  id           String         @id @default(cuid())
  /// Optional like every other word on a banner: artwork that carries its own
  /// typography needs no headline laid over it.
  title        String?
  eyebrow      String?
  description  String?
  /// Blob URL. Null renders the brand gradient scene rather than a blank box.
  imageUrl     String?
  imageAssetId String?
  imageAsset   MediaAsset?    @relation("BannerImage", fields: [imageAssetId], references: [id], onDelete: Restrict)
  imageAlt     String?
  /// Server-owned. A create appends to the end; only the reorder route rewrites it.
  order        Int            @default(0)
  /// Taken down, not deleted — the copy and artwork survive for the next run.
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  actions      BannerAction[]

  @@index([isActive, order])
}

/// Rows rather than JSON on Banner, so a label and a destination are columns the
/// database can constrain.
model BannerAction {
  id       String              @id @default(cuid())
  bannerId String
  /// Cascade is the correct side of ADR-0020: an action carries no money and no
  /// attribution, and has no meaning apart from its banner.
  banner   Banner              @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  label    String
  href     String
  variant  BannerActionVariant @default(PRIMARY)
  order    Int                 @default(0)

  @@index([bannerId, order])
}

enum BannerActionVariant {
  PRIMARY
  SECONDARY
}

// ─────────────────────────────────────────────────────────────────────────────
// BIDDING — one item sold by timed bidding on a shareable link
// (docs/specs/bidding/, ADR-0007, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// Only what the clock cannot decide (bidding D3). Whether an OPEN event is scheduled,
/// running or finished is derived from its timestamps on every read, so no scheduled job
/// has to have run for the answer to be right. Nothing may branch on this column alone.
enum BiddingStatus {
  OPEN
  CANCELLED
  SOLD
  UNSOLD
}

/// One item offered for timed bidding on a public link.
///
/// `highestBidPaise` and `bidCount` are derived, but written only inside the guarded
/// conditional update that accepts a bid (bidding D5/D7), so they are authoritative by
/// construction rather than by reconciliation — and they make the public page, which is
/// read far more often than it is written, a single row read.
///
/// Two constraints the schema language cannot express are raw SQL in the migration: a
/// partial unique index on `productId` where the status is OPEN, so a product is under
/// at most one live event and two simultaneous creations cannot both succeed (D4, R7);
/// and a check that the bidding window is ordered.
///
/// Restricts its product, org and people: an event carries money and attribution, so
/// deletion is refused and the real operation is cancellation (ADR-0020, R27).
model BiddingEvent {
  id   String @id @default(cuid())
  /// The public link's token — random, never the product slug, so the link is
  /// unguessable and independent of a slug frozen for other reasons (D16, R9).
  slug String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Which item this is, where the product has options. Descriptive only: `ProductStock`
  /// has no variant dimension, so this states what is being sold without creating
  /// variant-level inventory (D10, R1a).
  size  String?
  color String?

  startAt DateTime
  endAt   DateTime

  startingBidPaise    Int
  /// The most one bid may add to the current high. A bidder wanting to go further bids
  /// again, which caps a bad-faith bid without capping the auction (R6).
  maxIncreasePaise    Int
  /// The org's own quick-bid amounts, ascending. The smallest also floors a custom
  /// increase, so the buttons on screen cannot contradict the rule (R5, R13).
  quickBidsPaise      Int[]
  /// The product's price when the event opened, copied so later repricing cannot rewrite
  /// what the event says the item was worth (D9, R4).
  referencePricePaise Int

  status BiddingStatus @default(OPEN)

  highestBidPaise Int?
  bidCount        Int  @default(0)

  /// Written together when the platform records the outcome (R40, R43). The amount is
  /// what the org is owed and may differ from the winning bid, which is why the reason
  /// is kept beside it rather than inferred later.
  soldBidId       String?   @unique
  soldBid         Bid?      @relation("SoldBid", fields: [soldBidId], references: [id], onDelete: Restrict)
  soldAmountPaise Int?
  soldReason      String?   @db.Text
  settledAt       DateTime?
  settledById     String?
  settledBy       User?     @relation("BiddingSettledBy", fields: [settledById], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("BiddingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  bids Bid[] @relation("EventBids")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the purchase-suspension lookup, which asks for OPEN events by product
  /// (D8/D8a) — the one query on the storefront's read path.
  @@index([status, productId])
  @@index([status, endAt])
  @@index([orgId, status])
}

/// One bid, kept for good: nothing is removed while an event runs, and the ladder is what
/// the platform works down when a winner does not go through with it (R27, R39).
///
/// A guest's details sit on the row, following the address snapshot already carried on
/// `Order` — there is no guest table. Email is nullable by decision: a bidder who gives
/// none cannot be told they were outbid, which the form discloses at the point of
/// choosing (D14, R22/R22a/R28). A check in the migration requires either a user or a
/// guest name and phone, so a bid is always attributable to someone.
///
/// Unique on `(eventId, amountPaise)`: the guarded update already makes equal bids
/// impossible, and this makes it impossible independently of that guard being written
/// correctly, so no tiebreak rule has to exist anywhere (D6, H1).
model Bid {
  id      String       @id @default(cuid())
  eventId String
  event   BiddingEvent @relation("EventBids", fields: [eventId], references: [id], onDelete: Restrict)

  amountPaise Int

  /// Set for a signed-in bidder, whose contact details are read through the relation so
  /// they cannot go stale. A guest fills the columns below instead — never both.
  userId     String?
  user       User?   @relation("UserBids", fields: [userId], references: [id], onDelete: Restrict)
  guestName  String?
  guestPhone String?
  guestEmail String?

  createdAt DateTime @default(now())

  wonEvent BiddingEvent? @relation("SoldBid")

  @@unique([eventId, amountPaise])
  @@index([eventId, amountPaise(sort: Desc)])
  @@index([userId])
}
