// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  // Join strategy for relation reads: one LATERAL JOIN instead of one query per
  // relation table. On per-operation billing that difference is the bill (CHANGELOG
  // PR-70/71). Applied per-query via relationLoadStrategy, not globally.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  /// Self-referencing tree (category-tree D1/D2): null = root. Restrict, so a parent
  /// with children cannot be deleted; cycles are refused on the write path.
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryTree")
  description String         @db.Text
  heroImage   String // URL to hero image
  accent      CategoryAccent @default(EMERALD)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]

  promotionTargets PromotionTarget[]
  commissionRules  OrgCommissionRule[]

  @@index([slug])
  @@index([order])
  @@index([parentId])
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @db.Text
  price       Int // paise (Invariant 3). A reduction is an offer, never a column
  // on the product — see Promotion (ADR-0018 decision 4, promotions D9).
  currency    String @default("INR")

  categoryId String
  // Restrict, not Cascade: deleting a category must never delete its products
  // (category-tree D3 — the cascade only ever had an application-level count in its way).
  // Now the general rule rather than a local judgement (ADR-0020).
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags  String[] // Array of tags
  flags String[] @default([])
  // `images String[]` was here until product-video; a gallery is `media` now.

  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  /// Cache of the cover row's `ref` (product-video D4a/D4b), so every listing, search
  /// result, cart line and order line reads one table. Written only by the resolver,
  /// never from input; NOT NULL is the one database-level guarantee that a product has
  /// a picture at all.
  thumbnail    String
  sizes        String[] // Available sizes
  colors       String[] // Available colors

  sku               String? // Stock Keeping Unit — unique within the org, not the platform
  lowStockThreshold Int     @default(10) // Alert when stock falls below this

  orderItems       OrderItem[]
  cartItems        CartItem[]
  stockLocations   ProductStock[]
  media            ProductMedia[]
  promotionTargets PromotionTarget[]

  // ⭐ Org Association (REQUIRED)
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  // ⭐ ADD THIS:
  weight Float? @default(0.5) // Weight in kg

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  // A SKU is the org's own identifier; two orgs may legitimately use the same one.
  @@unique([orgId, sku])
  @@index([slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([orgId])
}

/// One item in a product's gallery — a photograph or an embedded video, in an order
/// the seller composes ([ADR-0017](../docs/adr/0017-video-is-embedded-not-hosted.md),
/// docs/specs/product-video/).
///
/// `position` orders the gallery and means nothing outside it (R16). The cover is the
/// row flagged `isThumbnail`, never the row at position 0, which is what lets a video
/// lead the gallery. Two constraints the schema language cannot express are added as
/// raw SQL in the migration: a partial unique index making at most one cover per
/// product a database fact, and a check that a cover is always an IMAGE.
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind MediaKind
  /// A blob URL for IMAGE, a bare video id for YOUTUBE — never a provider URL, so the
  /// host stays swappable by backfill rather than by migration (ADR-0017 decision 2).
  ref  String

  position    Int
  /// Per-item alt text. Nullable because the backfill has none to give: pre-existing
  /// galleries only ever had positional alt text generated at render.
  description String?

  isThumbnail Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId])
}

enum MediaKind {
  IMAGE
  YOUTUBE
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating     Int // 1-5
  title      String?
  comment    String?  @db.Text
  userName   String // Store name in case user is deleted
  isVerified Boolean  @default(false) // Verified purchase
  isApproved Boolean  @default(true) // Admin can moderate reviews
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@index([isApproved])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The pre-PR-44 blob, kept one release as the audit copy of the lift. Read by
  // nothing; lines live in CartItem rows (order-and-cart-lines trd.md).
  legacyItems Json?      @map("items")
  items       CartItem[]
  version     Int        @default(1) // For optimistic locking
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Cascade, unlike OrderItem: a cart line is a wish, not history — deleting the
  // product just removes it from carts.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int
  size     String?
  color    String?

  @@index([cartId])
  @@index([productId])
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  emailVerified   DateTime? // Keep this for NextAuth compatibility
  isEmailVerified Boolean      @default(false) // Our custom field
  mobile          String?      @unique
  passwordHash    String?
  platformRole    PlatformRole @default(USER)
  isBlocked       Boolean      @default(false)
  lastActiveAt    DateTime     @default(now())
  profile         Profile?
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  adminLogs       AdminLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accounts       Account[]
  sessions       Session[]
  orgMemberships OrgMember[]
  addresses      UserAddress[]

  settlementsCreated Settlement[] @relation("SettlementCreatedBy")
  settlementsUpdated Settlement[] @relation("SettlementUpdatedBy")

  @@index([platformRole])
  @@index([isBlocked])
  @@index([lastActiveAt])
  @@index([isEmailVerified])
}

model Profile {
  id              String  @id @default(cuid())
  user            User    @relation(fields: [userId], references: [id])
  userId          String  @unique
  legacyAddresses Json?   @map("addresses") // pre-PR-41 blob, kept one release as backup; read by nothing
  profilePic      String? // URL to avatar image
}

model Org {
  id   String @id @default(cuid())
  code String @unique // "SEL-001", "SEL-002"
  name String // "ABC Traders", "XYZ Wholesale"

  // Contact Information
  email         String
  phone         String?
  contactPerson String? // "John Doe"

  // Business Details
  orgAddresses OrgAddress[]

  businessName String?
  gstNumber    String?
  panNumber    String?

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false) // KYC verification

  // Metadata
  description String? @db.Text
  logoUrl     String?

  /// The platform's cut, in basis points — 1500 = 15%. Set per org by design; rates
  /// differ between orgs (org-payouts spec R12). Category overrides live in
  /// `OrgCommissionRule`, and the resolved rate is snapshotted onto every ledger
  /// line so a later change cannot rewrite a past settlement (payouts D4).
  commissionBps  Int @default(1500)
  /// How deep this org may discount its **own** goods. A guard against mis-keying a
  /// margin away with self-serve signup — not a platform protection, since an org's
  /// discount shrinks the platform's commission proportionally and can never drive it
  /// negative (promotions D13a).
  maxDiscountBps Int @default(5000)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products  Product[]
  shipments Shipment[]
  members   OrgMember[]

  promotions      Promotion[]
  orderDiscounts  OrderDiscount[]
  commissionRules OrgCommissionRule[]
  ledgerEntries   OrgLedgerEntry[]
  settlements     Settlement[]

  @@index([email])
  @@index([isActive])
  @@index([code])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id     String  @id @default(cuid())
  code   String  @unique // "BB-1001"
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Delivery address (same for all shipments)
  address Json // OrderAddress
  notes   String? @db.Text

  // ✅ NEW: Order-level totals
  itemsTotal    Int @default(0) // paise
  shippingTotal Int @default(0) // paise
  discount      Int @default(0) // paise
  grandTotal    Int @default(0) // paise: itemsTotal + shippingTotal - discount

  // Payment (single for entire order)
  paymentMethod  String? // "razorpay"
  paymentStatus  String? @default("pending") // pending, paid, failed
  paymentId      String? // the CONFIRMED gateway payment id — the idempotency key (payment-confirmation D2)
  gatewayOrderId String? // the gateway order this order was charged through; created with amount = grandTotal

  // Overall order status (derived from shipments)
  status String @default("processing") // processing, partially_shipped, completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ NEW: Relations to shipments
  items          OrderItem[]
  shipments      Shipment[]
  shippingEvents ShippingEvent[] // ← ADD THIS

  /// One row per offer that touched this order, carrying who funded it (ADR-0019).
  /// `discount` above is their sum — a display total, never an input to settlement.
  discounts     OrderDiscount[]
  ledgerEntries OrgLedgerEntry[]

  @@index([userId])
  @@index([code])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt]) // the reconciliation sweep asks "pending and old"
  @@index([gatewayOrderId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Restrict: a sold product cannot be deleted out from under its order history
  // (order-and-cart-lines R2).
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity  Int
  unitPrice Int // paise — the price as it stood at purchase, from birth (ADR-0004)
  /// The picture as it stood at purchase (product-video R17/D19). Same kind of fact as
  /// `unitPrice`: written server-side at order creation, never updated, never accepted
  /// from a request body. Stores the URL rather than a media id, because the media row
  /// is exactly what gets deleted in the case this exists for. Nullable only for rows
  /// that predate the column — the backfill fills what it can, which is today's cover,
  /// not what those buyers saw.
  thumbnail String?

  /// This line's share of the buyer's discount, allocated by largest-remainder
  /// rounding so per-line shares sum to the scope total exactly (ADR-0019).
  discountPaise  Int @default(0)
  /// How much of `discountPaise` the org bore; the platform bore the remainder.
  /// Persisted per line rather than only per offer because the ledger's commission
  /// base is `unitPrice * quantity - orgFundedPaise` **per line**, and rates resolve
  /// per line too (org-payouts D4c). Deriving it at settlement time would mean
  /// re-running the offer engine against a catalogue that has since moved.
  orgFundedPaise Int @default(0)

  // The chosen variant. Nullable: products without options have neither.
  size  String?
  color String?

  shipmentItems ShipmentItem[]
  ledgerLines   OrgLedgerEntryLine[]

  @@index([orderId])
  @@index([productId])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Cascade with the order line: the link is meaningless without it, and an
  // OrderItem only ever dies with its whole order.
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity Int

  @@index([shipmentId])
  @@index([orderItemId])
}

model Shipment {
  id   String @id @default(cuid())
  code String @unique // "BB-1001-SH1", "BB-1001-SH2"

  // Parent order
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The pre-PR-43 blob, kept one release as the audit copy of the lift. Read by
  // nothing; lines live in ShipmentItem rows (order-and-cart-lines trd.md).
  legacyItems Json?          @map("items")
  items       ShipmentItem[]

  // ✅ Origin details (where it ships from)
  orgId        String
  org          Org         @relation(fields: [orgId], references: [id])
  /// The pickup location this parcel was allocated from (stock-locations D5/D6).
  /// Nullable: pre-existing shipments keep NULL rather than a guessed attribution.
  /// The from* columns below stay as the historical snapshot — editing a location's
  /// address must never rewrite where a delivered parcel came from (A5).
  orgAddressId String?
  orgAddress   OrgAddress? @relation(fields: [orgAddressId], references: [id], onDelete: Restrict)
  fromPincode  String
  fromCity     String
  fromState    String

  // ✅ Shipping details (specific to this shipment)
  shippingCost       Int // paise
  shippingProviderId String?
  shippingProvider   ShippingProvider? @relation(fields: [shippingProviderId], references: [id])

  // ✅ Tracking (independent per shipment)
  trackingNumber String?
  courierName    String? // "BlueDart Surface"
  trackingUrl    String?

  // ✅ Status (independent per shipment)
  status            String    @default("processing") // processing, packed, shipped, delivered
  shipmentStatus    String? // Provider-specific status
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  // Package details
  packageWeight     Float?
  packageDimensions Json? // {length, width, height}

  // Metadata
  shippingMeta Json? // Provider-specific data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shippingEvents ShippingEvent[]

  @@index([orderId])
  @@index([orgId])
  @@index([status])
  @@index([trackingNumber])
}

model ShippingProvider {
  id          String  @id @default(cuid())
  code        String  @unique // 'shiprocket', 'delhivery', 'bluedart', etc.
  name        String // Display name: "Shiprocket", "Delhivery"
  description String? @db.Text // Provider description

  priority Int @default(0) // Higher number = higher priority

  // Authentication & Connection Status
  isConnected    Boolean   @default(false) // Is account connected?
  connectedAt    DateTime? // When was it connected?
  connectedBy    String? // Admin user ID who connected it
  connectionType String    @default("email_password") // [ 'email_password', 'api_key', 'oauth' ]
  lastAuthAt     DateTime? // Last successful authentication
  authError      String?   @db.Text // Last auth error message

  // Encrypted sensitive data
  authToken      String?   @db.Text // Encrypted JWT token
  tokenExpiresAt DateTime? // Token expiry timestamp

  // Account info (includes encrypted password)
  accountInfo Json? // {
  //   email: string,
  //   password: string (encrypted),
  //   firstName: string,
  //   lastName: string,
  //   companyId: number,
  //   warehousePincode?: string
  // }

  // Capabilities
  paymentOptions String[] // ['prepaid', 'cod']
  deliveryModes  String[] // ['air', 'surface']
  features       Json? // {tracking: true, label: true, scheduling: true}

  // Metadata
  logoUrl    String? // Provider logo
  websiteUrl String? // Provider website

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments Shipment[]
  rateCache ShippingRateCache[]
  events    ShippingEvent[]

  @@index([isConnected])
  @@index([code])
}

// Caches shipping rates to reduce API calls and improve performance
model ShippingRateCache {
  id String @id @default(cuid())

  // Provider reference
  providerId String
  provider   ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Rate calculation parameters
  fromPincode String
  toPincode   String
  weight      Float // in kg
  mode        String // 'prepaid', 'cod'

  // Cached rate information
  rate          Int // paise
  courierName   String // Courier service name
  estimatedDays Int // Estimated delivery days

  // Additional metadata
  metadata Json? // Any additional provider-specific data

  // Cache management
  expiresAt DateTime // When this cache entry expires
  createdAt DateTime @default(now())

  @@unique([providerId, fromPincode, toPincode, weight, mode])
  @@index([expiresAt])
  @@index([fromPincode])
  @@index([toPincode])
}

// Tracks all shipping-related events for debugging and analytics
model ShippingEvent {
  id String @id @default(cuid())

  // Order reference
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Shipment reference
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Provider reference
  providerId String
  provider   ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Event details
  eventType String // 'rate_check', 'shipment_created', 'status_update', 'cancellation'
  status    String // 'success', 'failed', 'pending'

  // Request/Response logging (for debugging)
  request  Json? // API request payload
  response Json? // API response

  // Error tracking
  errorMessage String? @db.Text
  errorCode    String?

  // Metadata
  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([shipmentId])
  @@index([providerId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

// Admin activity logging
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  // Restrict, not Cascade: deleting an admin must never erase the audit trail of
  // what they did — that is the record you want most when removing one. Block or
  // deactivate the account instead (User.isBlocked).
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String // e.g., "USER_BLOCKED", "PRODUCT_UPDATED"
  resource   String // e.g., "User", "Product", "Order"
  resourceId String // ID of the affected resource
  metadata   Json? // Additional details about the action
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([resource])
  @@index([action])
}

/// What a person may do inside one org. Declared here rather than as a TypeScript
/// union so there is exactly one declaration and the database rejects anything else —
/// unlike `ProductFlag`, which is a TS enum over a `String[]` because Postgres arrays
/// of enums are awkward. A role is scalar, so it does not need that compromise.
enum OrgRole {
  OWNER
  STAFF
}

/// A person's membership of an org. The relationship carries the role, because a role
/// on `User` could not express "owner of A, staff at B".
///
/// Cascade on both sides is deliberate: a membership is meaningless without either end,
/// and deleting one end must remove only the link — never the other party.
/// A selling organisation's pickup location (stock-locations D1/D10): the org's
/// relationship to a postal Address — courier nickname, who answers the door at
/// pickup, and the aggregator registration designed for but not built (D11).
/// Restrict both ways: an org with locations, or a location an Address underpins,
/// cannot be deleted out from under the other.
model OrgAddress {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  name         String // courier pickup nickname — "Bhendi Bazaar shop", "Bhiwandi godown"
  contactName  String // '' until a human completes it; required if fulfilment books real pickups
  contactPhone String
  isActive     Boolean @default(true)
  /// Aggregator pickup-location reference (D11): carried, read by nothing yet.
  providerRef  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productStock ProductStock[]
  shipments    Shipment[]

  @@index([orgId])
}

/// Where a product's units physically sit (stock-locations D2): the quantity lives
/// on the join row, because a location without a quantity is a place the store
/// cannot honour a quote from. Restrict on the location side is R8 in the database.
model ProductStock {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orgAddressId String
  orgAddress   OrgAddress @relation(fields: [orgAddressId], references: [id], onDelete: Restrict)
  quantity     Int

  @@id([productId, orgAddressId])
  @@index([orgAddressId])
}

model OrgMember {
  id     String  @id @default(cuid())
  userId String
  orgId  String
  role   OrgRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Whether a person runs the platform. Distinct in kind from `OrgRole`: there is exactly
/// one platform, so this is a property of the person, whereas a role inside an org is a
/// property of a relationship. Kept an enum rather than a boolean because a read-only
/// support role is a plausible third value.
enum PlatformRole {
  USER
  ADMIN
}

/// A category's accent, stored as a semantic key and mapped to classes at render
/// (`src/lib/category-accent.ts`). Rows used to hold raw Tailwind class strings —
/// presentation frozen into the database, which broke the moment the classes moved.
enum CategoryAccent {
  EMERALD
  BLUE
  PURPLE
  PINK
  ORANGE
  YELLOW
  RED
  GRAY
}

/// A postal fact, identity-agnostic (addresses-as-entities D1/D2): who receives there
/// lives on the owning relationship (`UserAddress` now, `OrgAddress` when
/// stock-locations lands). No uniqueness on purpose — free text does not normalise,
/// and a shared row would force copy-on-write on every edit.
model Address {
  id           String  @id @default(cuid())
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  /// Provenance, not ownership — nullable so seeds and system rows are honest.
  createdBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAddresses UserAddress[]
  orgAddresses  OrgAddress[]

  @@index([pincode])
}

/// A person's relationship to an address: their label for it, and who receives there
/// (not necessarily the account holder). No `isDefault` by decision — the buyer picks
/// at checkout.
model UserAddress {
  id        String  @id @default(cuid())
  userId    String
  addressId String
  label     String?
  fullName  String
  phone     String
  email     String?
  notes     String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Promotions — offers the platform and its orgs can run
// (docs/specs/promotions/, ADR-0018, ADR-0019, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// Who funds an offer. Genuinely two-valued and staying so, which is why it is an
/// enum while *what an offer covers* is a table (promotions D2).
enum PromotionScope {
  PLATFORM
  ORG
}

/// How an offer activates. AUTOMATIC offers set the price shown on a product page,
/// so they may carry no basket-level condition; CODE offers are entered at checkout,
/// where the basket is known, and may (promotions D5).
enum PromotionTrigger {
  AUTOMATIC
  CODE
}

/// PERCENT and AMOUNT_OFF reduce; FIXED_PRICE sets an outright selling price, which
/// is what a per-product markdown means and what a percentage cannot express
/// (promotions D4/D9). FIXED_PRICE is only legal on a product-targeted offer.
enum PromotionValueType {
  PERCENT
  AMOUNT_OFF
  FIXED_PRICE
}

/// A time-boxed offer. Three independent axes: who funds it (`scope`), how it
/// activates (`trigger`), and what it covers (`targets` — zero rows means everything
/// in scope, promotions D3).
///
/// Constraints the schema language cannot express are added as raw SQL in the
/// migration: scope/orgId agreement, trigger/code agreement, a value matching its
/// type, and endsAt after startsAt.
model Promotion {
  id    String @id @default(cuid())
  /// Shown to the buyer on the line badge and frozen onto OrderDiscount at purchase.
  label String

  scope PromotionScope
  /// Set iff scope = ORG. Restrict: an org with campaign history is not deletable.
  orgId String?
  org   Org?           @relation(fields: [orgId], references: [id], onDelete: Restrict)

  trigger PromotionTrigger
  /// Set iff trigger = CODE. Globally unique — a buyer types one string and it must
  /// resolve to exactly one offer. Org codes carry the org's own code as a prefix
  /// (promotions D13), which makes collisions impossible rather than merely reported.
  code    String?          @unique

  valueType       PromotionValueType
  /// Basis points — 2000 = 20%. Integer, so no float reaches the money path (ADR-0004).
  percentBps      Int?
  amountOffPaise  Int?
  fixedPricePaise Int?

  /// CODE offers only (promotions D5): a product page cannot know the basket.
  maxDiscountPaise Int?
  minSubtotalPaise Int  @default(0)

  /// Every offer is time-boxed — no offer runs indefinitely (spec R4).
  startsAt DateTime
  endsAt   DateTime
  /// The kill switch, independent of the window: a mispriced sale must die in one
  /// click, not a date edit (spec R5).
  isActive Boolean  @default(true)

  /// Enforced with a conditional update inside the order transaction (promotions D11,
  /// ADR-0007). Read-then-write oversells a coupon exactly as it oversells stock.
  usageLimit   Int?
  usageCount   Int  @default(0)
  perUserLimit Int?

  targets        PromotionTarget[]
  orderDiscounts OrderDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([scope, orgId])
  @@index([trigger])
}

/// What an offer covers. Exactly one dimension per row; zero rows on a promotion
/// means "everything in scope" (promotions D3), which is why these **restrict**
/// their category and product: a cascade would remove an offer's only target and
/// silently widen it store-wide (promotions D3a, ADR-0020).
///
/// Cascade on `promotionId` is composition, not reference — the same distinction
/// `OrderItem` already draws between its order and its product.
model PromotionTarget {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  /// A category target covers its whole subtree (promotions spec R2).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([promotionId, categoryId])
  @@unique([promotionId, productId])
  @@index([categoryId])
  @@index([productId])
}

/// One offer's effect on one order, with its cost divided between the two parties
/// who could have paid for it (ADR-0019). `orgFundedPaise + platformFundedPaise =
/// buyerDiscountPaise` is asserted by a CHECK in the migration, so no settlement can
/// be computed from a split that does not reconcile.
///
/// Restricts both its promotion and its order: this row is the attribution a payout
/// reads, and it must outlive any tidying of either (ADR-0020).
model OrderDiscount {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  /// Whose lines this concerns. Always set — a platform offer still lands on some
  /// org's goods, and the ledger needs to know whose.
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Frozen at purchase, so a renamed or reworded offer cannot rewrite a receipt —
  /// the same reasoning that froze `thumbnail` onto OrderItem.
  labelSnapshot String
  codeSnapshot  String?

  buyerDiscountPaise  Int
  orgFundedPaise      Int
  platformFundedPaise Int

  createdAt DateTime @default(now())

  @@unique([orderId, promotionId, orgId])
  @@index([promotionId])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payouts — what each org earned, what the platform kept, what is still owed
// (docs/specs/org-payouts/, ADR-0019, ADR-0020)
// ─────────────────────────────────────────────────────────────────────────────

/// SALE is written from the paid transition; REVERSAL offsets one; ADJUSTMENT is a
/// manual line the order flow does not produce — a reimbursement, a penalty
/// (payouts D6, spec R5).
enum LedgerEntryKind {
  SALE
  REVERSAL
  ADJUSTMENT
}

/// What gates editing (payouts D6). DRAFT is editable; once its settlement is paid
/// the entry is SETTLED and its figures are fixed, because it now records a transfer
/// that actually happened.
enum LedgerEntryState {
  DRAFT
  SETTLED
  REVERSED
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED
}

/// An org's commission rate for a category, overriding its default. Nearest ancestor
/// wins, so a rate on a parent means "unless a child says otherwise" with no
/// precedence field to configure (payouts D4a/D4b).
///
/// Restricts its category: a cascade here would silently move an org onto a
/// different rate (ADR-0020).
model OrgCommissionRule {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  rateBps Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, categoryId])
  @@index([orgId])
  @@index([categoryId])
}

/// One org's share of one order, written when the order is paid — never when it is
/// placed, so an order that never pays never appears in a payout (payouts D5).
///
/// `commissionBase = grossItemsPaise - orgFundedDiscountPaise`: commission is charged
/// on what the org's goods earned after the org's own discount, and before any
/// discount the platform chose to fund. Basing it on what the buyer paid would
/// quietly make the org co-fund the platform's campaign (payouts D2).
///
/// No rate column: rates resolve per item, so one entry can carry several and the
/// rate lives on the line (payouts D4c).
model OrgLedgerEntry {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Null for a manual adjustment, which has no order behind it (spec R5).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  kind  LedgerEntryKind  @default(SALE)
  state LedgerEntryState @default(DRAFT)

  grossItemsPaise             Int
  orgFundedDiscountPaise      Int
  /// Informational: excluded from the base, shown as the platform's campaign cost
  /// against this order (payouts D2, spec R17).
  platformFundedDiscountPaise Int
  commissionBasePaise         Int
  commissionPaise             Int
  /// Signed, so a REVERSAL is the same shape with the opposite sign (payouts D6).
  payablePaise                Int

  /// Raised on write rather than found in a reconciliation (payouts D12). True when
  /// the platform funded more than it earned on this entry.
  isNegativeMargin Boolean   @default(false)
  /// A figure that no longer derives from its order should not look like one that
  /// does (payouts D9b).
  isManuallyEdited Boolean   @default(false)
  /// Soft delete: a hard one would drop money out of a balance leaving nothing to
  /// explain the change (payouts D9a).
  deletedAt        DateTime?

  note String?

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  lines OrgLedgerEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, orgId, kind])
  @@index([orgId, deletedAt])
  @@index([settlementId])
  @@index([isNegativeMargin])
}

/// One order line's contribution to an entry, carrying the rate that actually
/// applied to it (payouts D4c). Cascade on the entry is composition; Restrict on the
/// order line is a reference to another aggregate — the same split `OrderItem` draws
/// between its order and its product.
model OrgLedgerEntryLine {
  id      String         @id @default(cuid())
  entryId String
  entry   OrgLedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Null for a manual adjustment's line.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  basePaise       Int
  rateBps         Int
  commissionPaise Int

  @@index([entryId])
  @@index([orderItemId])
}

/// A batch of entries the platform has paid, or intends to. Free-form over whatever
/// is unsettled — no period and no schedule, because a transfer is decided when it
/// suits and a period column would only describe which entries happened to be picked
/// (payouts D7).
model Settlement {
  id    String @id @default(cuid())
  code  String @unique
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  amountPaise Int
  status      SettlementStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?
  note        String?

  /// Restrict, as `AdminLog` already does: removing a person must never erase the
  /// record of what they authorised.
  createdByUserId String
  createdBy       User    @relation("SettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String?
  updatedBy       User?   @relation("SettlementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  entries OrgLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([code])
}

/// The storefront's hero banners. Platform-owned shelf space: an org promoting its own
/// products is what offers are for.
model Banner {
  id          String         @id @default(cuid())
  title       String
  eyebrow     String?
  description String?
  /// Blob URL. Null renders the brand gradient scene rather than a blank box.
  imageUrl    String?
  imageAlt    String?
  /// Server-owned. A create appends to the end; only the reorder route rewrites it.
  order       Int            @default(0)
  /// Taken down, not deleted — the copy and artwork survive for the next run.
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  actions     BannerAction[]

  @@index([isActive, order])
}

/// Rows rather than JSON on Banner, so a label and a destination are columns the
/// database can constrain.
model BannerAction {
  id       String              @id @default(cuid())
  bannerId String
  /// Cascade is the correct side of ADR-0020: an action carries no money and no
  /// attribution, and has no meaning apart from its banner.
  banner   Banner              @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  label    String
  href     String
  variant  BannerActionVariant @default(PRIMARY)
  order    Int                 @default(0)

  @@index([bannerId, order])
}

enum BannerActionVariant {
  PRIMARY
  SECONDARY
}
