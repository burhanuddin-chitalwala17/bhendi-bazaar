# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the samples, which are the point: they carry no secret and are how a
# new machine learns what has to be set. `.env*` above would otherwise hide them.
!.env.example
!.env.production.example
!.env.worker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Listing node templates: 19MB of another company's binary spreadsheets, which git cannot
# diff and never forgets. The manifest and the data extracted from them are committed;
# the payloads are not. See listing-node-templates/README.md.
/listing-node-templates/**/*.xls
/listing-node-templates/**/*.xlsx
/listing-node-templates/**/*.xlsm
