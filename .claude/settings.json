{
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./.next/**)",
      "Read(./docs/archive/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/post-edit.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
