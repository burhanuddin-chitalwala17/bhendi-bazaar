{
  "permissions": {
    "allow": [
      "Bash(git push origin *)",
      "Bash(git push -u origin *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Read(./package-lock.json)",
      "Read(./.next/**)",
      "Read(./docs/archive/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/post-edit.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
