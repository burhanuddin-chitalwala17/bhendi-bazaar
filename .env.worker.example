# The worker's environment file — written to /opt/worker/.env on its machine by the deploy, one
# WORKER_ENV_<NAME> repository secret per line (infra/worker/compose-env.sh). Never committed with
# values. Every name here is passed by name in ci.yml and staging-worker.yml; a name missing from
# a workflow fails tests/unit/deploy-safety.test.ts, so a new variable starts here.
# Names are the application's own (ADR-0037 D4): what a variable holds, not who provisioned it.

# The DIRECT connection string (db.prisma.io, not pooled.): notify needs a session.
DATABASE_URL=
# local | preview | production — keys the heartbeat and every environment branch.
APP_ENV=production

# The image store, for the jobs that read or write images (media-library, image-enhancement).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Photo enhancement runs here, not in the web app, so the tools' configuration has to reach the
# worker as well as Vercel — set in one and not the other, every run fails on the half that is
# missing. Same meanings as in `.env.example`; all three optional. Without the key, the settings
# that need the hosted model refuse rather than run: background removal falls back to the image
# host's own transform, which needs no key but does need R2_PUBLIC_BASE_URL on a custom domain.
IMAGE_SEGMENT_PROVIDER=
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_ENDPOINT=

# Same value as the site: the daily channels job renews and re-encrypts marketplace tokens.
CREDENTIAL_KEYS=
# The marketplace apps, so the daily job can renew and check each shop's connection.
AMAZON_APP_ID=
AMAZON_APP_SECRET=
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

# Read by shared server code the jobs import. Same meanings as in `.env.example`.
AMAZON_SOLUTION_ID=
CHANNELS_CONNECT=
EMAIL_FROM=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
ORG_HANDLE_HOLD_DAYS=
PRISMA_LOG_QUERIES=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
